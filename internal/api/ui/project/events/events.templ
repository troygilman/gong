package events

import (
	"context"
	"fmt"
	"github.com/google/uuid"
	"stagebase/internal/api/common"
	"stagebase/internal/api/ui/icons"
	"stagebase/internal/api/ui/timefilter"
	"stagebase/internal/core"
	"stagebase/internal/model"
	"stagebase/internal/persistance"
	"stagebase/pkg/gong"
	"strconv"
	"time"
)

func EventContentComponent(ctx context.Context) (templ.Component, error) {
	var (
		filter     model.Filter
		page       int
		timeFilter timefilter.TimeFilter
	)

	if err := gong.Bind(
		ctx,
		gong.NewBinding(common.ParamFilter, &filter),
		gong.NewBinding(ParamPage, &page),
		timefilter.Binding(&timeFilter),
	); err != nil {
		return nil, err
	}

	return eventContentComponent(filter, timeFilter, page), nil
}

templ eventContentComponent(filter model.Filter, timeFilter timefilter.TimeFilter, pageIdx int) {
	<div class="flex flex-row w-full h-16 min-h-16 px-4 py-2 border-b border-color items-center justify-between">
		<div class="flex items-center gap-4">
			@eventsFilter(filter)
			@timeFilter.Component("")
		</div>
		@eventTablePaginationControl(pageIdx, 0)
	</div>
	<div class="flex grow min-h-0 relative">
		<div
			id="events-container"
			class="flex flex-col grow overflow-y-auto"
			hx-ext="sse"
		>
			<input id="from-fixed" type="hidden" name={ FromFixedParam } value={ strconv.Itoa(int(timeFilter.From.UnixNano())) }/>
			<input id="to-fixed" type="hidden" name={ ToFixedParam } value={ strconv.Itoa(int(timeFilter.To.UnixNano())) }/>
			@EventTableComponent(true)
		</div>
		<div id="events-spinner" class="htmx-indicator absolute flex w-full h-full items-center justify-center pointer-events-none">
			<span class="loading loading-spinner w-16"></span>
		</div>
	</div>
}

templ eventTablePaginationControl(pageIndex int, maxPageIndex int) {
	<div id="pagination-controls" hx-swap-oob="true" class="join">
		@eventTablePaginationControlItem(pageIndex, 0, 0) {
			@icons.DoubleArrowIcon("")
		}
		@eventTablePaginationControlItem(pageIndex, pageIndex-1, 0) {
			@icons.ArrowIcon("")
		}
		<div class="join-item button-sm w-fit min-w-8 p-2 !text-base-content" disabled>
			<input id="page-index" type="hidden" name={ ParamPage } value={ strconv.Itoa(pageIndex) }/>
			{ strconv.Itoa(pageIndex) }
		</div>
		@eventTablePaginationControlItem(pageIndex, pageIndex+1, maxPageIndex) {
			@icons.ArrowIcon("rotate-180")
		}
		@eventTablePaginationControlItem(pageIndex, maxPageIndex, maxPageIndex) {
			@icons.DoubleArrowIcon("rotate-180")
		}
	</div>
}

templ eventTablePaginationControlItem(page int, nextPage int, disableOnPage int) {
	<button
		class="join-item button-sm fill-base-content disabled:fill-base-content/50"
		hx-get
		hx-include="[include], #page-index, #from-fixed, #to-fixed"
		hx-headers={ `{"View": "events"}` }
		hx-vals={ fmt.Sprintf(`{"%s": "%d"}`, ParamPage, nextPage) }
		hx-trigger="click"
		hx-target="#event-table"
		hx-swap="outerHTML"
		hx-indicator="#events-spinner"
		if page == disableOnPage {
			disabled
		}
	>
		{ children... }
	</button>
}

templ EventTableComponent(lazy bool) {
	@gong.NewComponent(EventTableProducer(lazy))
}

func EventTableProducer(lazy bool) gong.ComponentProducer {
	return func(ctx context.Context) (templ.Component, error) {
		return eventTableComponent(ctx, lazy)
	}
}

func eventTableComponent(ctx context.Context, lazy bool) (templ.Component, error) {
	var (
		app       core.App
		projectId uuid.UUID
		filter    model.Filter
		page      int
	)

	if err := gong.Bind(
		ctx,
		gong.NewBinding(common.ParamApp, &app),
		gong.NewBinding(common.ParamProjectId, &projectId),
		gong.NewBinding(common.ParamFilter, &filter),
		gong.NewBinding(ParamPage, &page),
	); err != nil {
		return nil, err
	}

	events := []model.Event{}
	maxPageIdx := 0

	if !lazy {
		var err error
		from := ctx.Value(FromFixedParam).(time.Time)
		to := ctx.Value(ToFixedParam).(time.Time)
		events, maxPageIdx, err = app.Database().QueryEvents(ctx, persistance.EventsQuery{
			ProjectID: projectId,
			From:      from,
			To:        to,
			PageIndex: page,
			Filter:    filter,
		})
		if err != nil {
			panic(err)
		}
	}

	return eventTable(events, lazy, page, maxPageIdx), nil
}

templ eventTable(events []model.Event, lazy bool, pageIdx int, maxPageIdx int) {
	<table
		id="event-table"
		class="table table-pin-rows table-sm"
		if lazy {
			hx-get
			hx-include="[include], #from-fixed, #to-fixed"
			hx-headers={ `{"View": "events"}` }
			hx-trigger="load"
			hx-indicator="#events-spinner"
			hx-swap="outerHTML"
		}
	>
		<input type="hidden" name="" value=""/>
		if len(events) > 0 {
			<thead>
				<tr class="cursor-default">
					<th>Timestamp</th>
					<th>Type</th>
					<th>Sender</th>
					<th>Receiver</th>
					<th>Level</th>
					<th>Message</th>
				</tr>
			</thead>
			<tbody>
				for _, event := range events {
					<tr id={ fmt.Sprintf("event-%s", strconv.Itoa(int(event.Timestamp.UnixNano()))) } class="event">
						<input type="hidden" value={ strconv.Itoa(int(event.Timestamp.UnixNano())) }/>
						<td>
							{ event.Timestamp.String() }
						</td>
						<td>
							{ event.Type }
						</td>
						<td>
							if event.Sender != "" {
								{ event.Sender }
							}
						</td>
						<td>
							{ event.PID }
						</td>
						<td>
							{ event.SlogLevel().String() }
						</td>
						<td>
							if event.Msg != "" {
								{ event.Msg }
							} else {
								N/A
							}
						</td>
					</tr>
				}
			</tbody>
		}
	</table>
	if !lazy && len(events) == 0 {
		<div class="flex flex-col grow min-h-0 items-center justify-center">
			@icons.DataErrorIcon("w-24 h-24")
			<div class="text-2xl">No events found</div>
			<div class="">No events match the selected filters</div>
		</div>
	}
	if !lazy {
		@eventTablePaginationControl(pageIdx, maxPageIdx)
	}
}
