package timefilter

import (
	"context"
	"fmt"
	"github.com/labstack/echo/v4"
	"stagebase/internal/api/common"
	"stagebase/internal/api/ui/icons"
	"time"
)

const (
	TimeFilterParam = "time_filter"
	FromParam       = "from"
	ToParam         = "to"
	FromNanosParam  = "from_nanos"
	ToNanosParam    = "to_nanos"
)

var (
	timeFilterOptions = []timeFilterOption{
		{
			label:    "15 minutes",
			value:    "now-15min",
			duration: 15 * time.Minute,
		},
		{
			label:    "30 minutes",
			value:    "now-30min",
			duration: 30 * time.Minute,
		},
		{
			label:    "1 hour",
			value:    "now-1hr",
			duration: time.Hour,
		},
		{
			label:    "3 hours",
			value:    "now-3hr",
			duration: 3 * time.Hour,
		},
		{
			label:    "1 day",
			value:    "now-1day",
			duration: 24 * time.Hour,
		},
		{
			label:    "7 days",
			value:    "now-7day",
			duration: 7 * 24 * time.Hour,
		},
	}
	timeFilterOptionMapping = buildTimeFilterOptionMap(timeFilterOptions)
)

type timeFilterOption struct {
	label    string
	value    string
	duration time.Duration
}

func buildTimeFilterOptionMap(options []timeFilterOption) map[string]timeFilterOption {
	m := make(map[string]timeFilterOption)
	for _, opt := range options {
		m[opt.value] = opt
	}
	return m
}

type TimeFilter struct {
	From    time.Time
	To      time.Time
	fromStr string
}

func Extract(e echo.Context) (any, any) {
	filter := TimeFilter{}

	fromStr := e.QueryParam(FromParam)
	if _, ok := timeFilterOptionMapping[fromStr]; ok {
		filter.fromStr = fromStr
	} else {
		filter.fromStr = timeFilterOptions[0].value
	}
	filter.From = time.Now().Add(-timeFilterOptionMapping[filter.fromStr].duration)

	filter.To = time.Now()

	return TimeFilterParam, filter
}

func MustGetTimeFilter(ctx context.Context) TimeFilter {
	return common.MustGetHelper[TimeFilter](ctx, TimeFilterParam)
}

func (f TimeFilter) Filter() {

}

templ (filter TimeFilter) Component(view string) {
	<button class="btn btn-sm btn-square no-animation border border-color p-1" onclick="my_modal_1.showModal()">
		@icons.CalandarIcon("")
	</button>
	<dialog id="my_modal_1" class="modal">
		<form method="dialog" class="modal-backdrop">
			<button></button>
		</form>
		<div class="modal-box">
			<form method="dialog">
				Lookback Range
				<button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
			</form>
			<div
				class="flex flex-col w-full"
				hx-get
				hx-headers={ fmt.Sprintf(`{"View": "%s"}`, view) }
				hx-include="[include]"
				hx-push-url="true"
				hx-trigger="flow-chart-filter-range-submit"
			>
				<div class="bg-base-200 border border-color rounded py-2 px-4">
					<div class="flex flex-row items-center gap-2">
						<div>Last</div>
						<select
							id="filter-from-time"
							include
							name={ FromParam }
							class="select select-sm select-bordered focus:outline-none"
						>
							for _, opt := range timeFilterOptions {
								@filter.option(opt.label, opt.value)
							}
						</select>
					</div>
				</div>
				<div class="flex flex-row justify-end pt-4">
					<div
						class="btn btn-sm border border-color"
						@click="$dispatch('flow-chart-filter-range-submit')"
					>Ok</div>
				</div>
			</div>
		</div>
	</dialog>
}

templ (filter TimeFilter) option(text string, value string) {
	<option
		value={ value }
		if value == filter.fromStr {
			selected
		}
	>
		{ text }
	</option>
}
