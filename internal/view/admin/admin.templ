package view

import (
	"fmt"
	"stagebase/internal/common"
	commonView "stagebase/internal/view/common"
)

templ Admin() {
	@commonView.Index() {
		<div hx-ext="sse" sse-connect={ commonView.FormatProjectUrl(ctx) + "/admin/sse" }>
			<div>
				Metrics
				<div class="flex flex-row">
					<div class="pr-2">Latency (ms):</div>
					@Metric(0, common.SseTypeUpdateMetricLatency)
				</div>
				<div class="flex flex-row">
					<div class="pr-2">Throughput (events/sec):</div>
					@Metric(0, common.SseTypeUpdateMetricThroughput)
				</div>
			</div>
		</div>
	}
}

templ Metric(val int64, sseSwap string) {
	<div sse-swap={ sseSwap }>{ fmt.Sprintf("%d", val) }</div>
}
