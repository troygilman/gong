package view

import (
	"fmt"
	"stagebase/internal"
	"stagebase/internal/view"
)

templ Admin() {
	@view.Index() {
		<div hx-ext="sse" sse-connect={ view.FormatProjectUrl(ctx) + "/admin/sse" }>
			<div>
				Metrics
				<div class="flex flex-row">
					<div class="pr-2">Latency (ms):</div>
					@Metric(0, internal.SseTypeUpdateMetricLatency)
				</div>
				<div class="flex flex-row">
					<div class="pr-2">Throughput (events/sec):</div>
					@Metric(0, internal.SseTypeUpdateMetricThroughput)
				</div>
			</div>
		</div>
	}
}

templ Metric(val int64, sseSwap string) {
	<div sse-swap={ sseSwap }>{ fmt.Sprintf("%d", val) }</div>
}
