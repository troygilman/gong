package common

type DrawerProps struct {
	ID     string
	Origin string
	Class  string
	Width  string
}

templ Drawer(props DrawerProps) {
	<div
		id={ props.ID }
		x-data="{ open: true }"
		@open.window="
	console.log('open')
	if (event.detail === $el.id) {
		console.log('open', event.detail);
		open = true;
	}
"
		@close.window="
	if (event.detail === $el.id) {
		console.log('close', event.detail);
		open = false;
	}
"
		@toggle.window="
	if (event.detail === $el.id) {
		console.log('toggle', event.detail);
		open = !open;
	}
"
		class={ "transition-width duration-300 ease-in-out overflow-hidden translate-x-0", props.Width, props.Class }
		:class="{ '!w-0 !-translate-x-full': !open}"
	>
		{ children... }
	</div>
}
