package project

import (
	"context"
	"fmt"
	gong_common "gong/internal/common"
	"gong/internal/view/common"
	"log/slog"
	"strconv"
	"strings"
	"time"
)

func eventsTabContent(ctx context.Context) templ.Component {
	app := gong_common.MustValueApp(ctx)
	projectID := gong_common.MustValueProjectID(ctx)
	actorPID := gong_common.MustValueActorPID(ctx)
	filter, _ := gong_common.ValueFilter(ctx)
	timeStart, ok := gong_common.ValueTimeStart(ctx)
	if !ok {
		actor, err := app.Actor(ctx, projectID, actorPID)
		if err != nil {
			return nil
		}
		timeStart = actor.LastEventTime
	}
	return eventsTabContentComponent(filter, timeStart)
}

templ eventsTabContentComponent(filter gong_common.Filter, timeStart time.Time) {
	<div class="w-full h-fit px-4 py-2 border-b border-color">
		@eventsFilter(filter)
	</div>
	<div
		id="events-container"
		class="grow min-h-0 max-w-full overflow-x-auto relative"
		hx-ext="sse"
		hx-include={ common.Includes }
		hx-sync="this:drop"
	>
		<input id="project-url" type="hidden" value={ common.FormatProjectUrl(ctx) }/>
		<input id="time-start" type="hidden" name={ gong_common.ParamTimeStart } value={ strconv.FormatInt(timeStart.UnixNano(), 10) }/>
		<table id="events-table" class="table table-pin-rows table-sm">
			<thead>
				<tr class="cursor-default">
					<th>Timestamp</th>
					<th>Type</th>
					<th>Sender</th>
					<th>Level</th>
					<th>Message</th>
				</tr>
			</thead>
			<tbody
				id="events"
				hx-get={ common.FormatProjectUrl(ctx) + "/events" }
				hx-trigger="load"
				hx-include={ common.Includes }
				hx-indicator="#events-spinner"
			></tbody>
		</table>
		<div id="events-spinner" class="htmx-indicator absolute flex top-0 w-full h-full items-center justify-center">
			<span class="loading loading-dots loading-lg"></span>
		</div>
	</div>
}

templ eventsFilter(filter gong_common.Filter) {
	<form
		id="events-filter"
		class="join w-fit mb-0"
		hx-get={ common.FormatProjectUrl(ctx) }
		hx-include={ common.Includes }
		hx-headers={ `{"View": "actor"}` }
		hx-trigger="submit"
		hx-swap="none"
		hx-push-url="true"
	>
		<script>
			function updateFilter() {
				console.log("updateFilter()");
				const inputs = document.getElementById('events-filter').querySelectorAll("input");
				for (const input of inputs) {
					if (input.value !== input.defaultValue || input.checked !== input.defaultChecked) {
						htmx.trigger('#events-filter', 'submit', {});
					}
				}
			}
		</script>
		@eventsFilterItem("Type", gong_common.ParamFilterType, filter.Type != nil, -1) {
			<input
				class="event-filter-input"
				name={ gong_common.ParamFilterType }
				type="text"
				placeholder="actor.Started"
				if filter.Type != nil {
					value={ *filter.Type }
				}
			/>
		}
		@eventsFilterItem("Sender", gong_common.ParamFilterSender, filter.Sender != nil, 0) {
			<input
				class="event-filter-input"
				name={ gong_common.ParamFilterSender }
				type="text"
				placeholder="local/server/primary"
				if filter.Sender != nil {
					value={ *filter.Sender }
				}
			/>
		}
		@eventsFilterItem("Level", gong_common.ParamFilterLevel, filter.Level != nil, 1) {
			<div class="px-2 py-1">
				@eventsFilterLevelOption("DEBUG", slog.LevelDebug, filter.Level)
				@eventsFilterLevelOption("INFO", slog.LevelInfo, filter.Level)
				@eventsFilterLevelOption("WARN", slog.LevelWarn, filter.Level)
				@eventsFilterLevelOption("ERROR", slog.LevelError, filter.Level)
			</div>
		}
	</form>
}

templ eventsFilterLevelOption(label string, level slog.Level, selected *slog.Level) {
	<div class="form-control">
		<label class="label cursor-pointer py-1">
			<span class="label-text">{ label }</span>
			<input
				type="radio"
				name={ gong_common.ParamFilterLevel }
				class="radio"
				value={ strconv.Itoa(int(level)) }
				if selected != nil && *selected == level {
					checked
				}
			/>
		</label>
	</div>
}

templ eventsFilterItem(label string, name string, active bool, placement int) {
	<div class="join-item indicator">
		if active {
			<span
				class="indicator-item badge badge-info badge-sm cursor-pointer pl-0 pr-0"
				hx-get={ common.FormatProjectUrl(ctx) }
				hx-include={ common.Includes }
				hx-params={ "not " + name }
				hx-headers={ `{"View": "actor"}` }
				hx-trigger="click"
				hx-swap="none"
				hx-push-url="true"
			>
				@common.CloseIcon("inline-block w-4 h-4 stroke-current")
			</span>
		}
		<div class="dropdown group/filter">
			<div
				tabindex="0"
				role="button"
				class={ "event-filter-button-container", templ.KV("rounded-l", placement < 0), templ.KV("rounded-r", placement > 0) }
			>
				<div class={ "event-filter-button", templ.KV("bg-neutral text-neutral-content", active) }>{ label }</div>
			</div>
			<div
				tabindex="0"
				class="dropdown-content z-50 shadow bg-base-100 rounded-lg rounded-tl-none w-64 border border-color"
				@focusout="if (!$el.contains($event.relatedTarget)) { updateFilter() }"
				@keydown.enter="updateFilter()"
			>
				{ children... }
			</div>
		</div>
	</div>
}

func formatActorPID(pid string) string {
	return strings.ReplaceAll(pid, "/", "-")
}

templ EventTableListComponent() {
	@eventTableListComponent(ctx)
}

func eventTableListComponent(ctx context.Context) templ.Component {
	app := gong_common.MustValueApp(ctx)
	projectID := gong_common.MustValueProjectID(ctx)
	actorPID := gong_common.MustValueActorPID(ctx)
	timeStart, _ := gong_common.ValueTimeStart(ctx)
	filter, _ := gong_common.ValueFilter(ctx)

	events, err := app.Events(ctx, projectID, actorPID, timeStart, filter)
	if err != nil {
		events = make(gong_common.EventList, 0)
	}
	return eventTableList(events)
}

templ eventTableList(events gong_common.EventList) {
	for i := len(events)-1; i >= 0; i-- {
		@eventTableListItem(events[i])
	}
}

templ eventTableListItem(event gong_common.Event) {
	<tr id={ fmt.Sprintf("event-%s", strconv.Itoa(int(event.Timestamp.UnixNano()))) } class="event">
		<input type="hidden" value={ strconv.Itoa(int(event.Timestamp.UnixNano())) }/>
		<td>
			{ event.Timestamp.String() }
		</td>
		<td>
			{ event.Type }
		</td>
		<td>
			if event.Sender != "" {
				{ event.Sender }
			} else {
				N/A
			}
		</td>
		<td>
			{ event.SlogLevel().String() }
		</td>
		<td>
			if event.Msg != "" {
				{ event.Msg }
			} else {
				N/A
			}
		</td>
	</tr>
}
