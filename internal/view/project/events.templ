package project

import (
	"context"
	"fmt"
	gong_common "gong/internal/common"
	"gong/internal/view/common"
	"log/slog"
	"strconv"
	"strings"
)

templ eventsTabContent(actor gong_common.Actor) {
	<div class="w-full h-fit px-4 py-2 border-b border-color">
		if filter, ok := ctx.Value(gong_common.CtxFilter).(gong_common.Filter); ok {
			@eventsFilter(filter)
		} else {
			@eventsFilter(gong_common.Filter{})
		}
	</div>
	@ProjectActorEventsContainer(actor)
}

templ ProjectActorEventsContainer(actor gong_common.Actor) {
	<div
		id="events-container"
		class="grow min-h-0 max-w-full overflow-x-auto relative"
		hx-ext="sse"
		hx-include={ common.Includes }
		hx-sync="this:drop"
		x-data={ `{
			init() {
				this.url = htmx.find("#project-url").value;

				this.status = new Uint8Array(new ArrayBuffer(1));

				document.addEventListener("fetch-events", (e) => {
					if (Atomics.compareExchange(this.status, 0, 0, 1) == 0) {
						const fetchWrapper = async function(data) {
							await data._fetch(e.detail);
							Atomics.store(data.status, 0, 0);
						}
						fetchWrapper(this);
					}
				});

				this.intervalID = window.setInterval(() => {
					this.fetch(this.nextIsTop);
					this.nextIsTop = !this.nextIsTop;
				}, 10); // time in ms

				this.fetch(false)

				this.eventSource = new EventSource(this.addParamsToURL(this.url + "/sse/events"));
				this.eventSource.addEventListener("new-events", (event) => {
					console.log("new-event")
					this.moreTop = true;
					this.newEvents = true;
				});
			},

			destroy() {
				clearInterval(this.intervalID);
				this.eventSource.close();
			},

			fetch(isTop) {
				const event = new CustomEvent("fetch-events", { detail: isTop });
				document.dispatchEvent(event);
			},

			async _fetch(isTop) {
				let currentNumEvents = htmx.find("#events").children.length;
				let loadTop = isTop && this.moreTop && (this.shouldLoadTop() || currentNumEvents < 100);
				let loadBottom = !isTop && this.moreBottom && (this.shouldLoadBottom() || currentNumEvents < 100);
				console.log("_fetch()", isTop, this.moreTop, this.moreBottom);
				if (loadTop || loadBottom) {
					const values = {
						n: 0,
						timestamp: "",
					}
					if (isTop) {
						values.n = 20;
						values.timestamp = this.getTopTimestamp();
					} else {
						values.n = -20
						values.timestamp = this.getBottomTimestamp();
					}
					console.log("fetch()", values);
					await htmx.ajax("GET", this.addParamsToURL(this.url + "/events"), {
						source: "#events-spinner",
						values: values,
						handler: (src, something) => {
							const html = something.xhr.responseText;
							if (isTop) {
								if (html == "") {
									if (!this.newEvents) {
										this.moreTop = false;
									}
								} else {
									this.moreTop = true;
									this.newEvents = false;
								}
								this.moreBottom = true;
							} else {
								if (html == "") {
									this.moreBottom = false;
								} else {
									this.moreBottom = true;
								}
								this.moreTop = true;
							}
							const spinner = htmx.find("#events-spinner");
							if (spinner) {
								htmx.remove(spinner);
							}
                            this.handleEvents(html, isTop);
						},
					});
				}
			},

			handleEvents(events, isTop) {
				const maxEvents = 200;
				const container = document.getElementById("events");
				if (container == null) {
					return;
				}
				if (isTop) {
					htmx.swap(container, events, {swapStyle: "afterbegin"}, {eventInfo: {isTop: isTop}});
					const overflow = container.children.length - maxEvents;
					if (overflow > 0) {
						for (let i = maxEvents; i < container.children.length; i++) {
							htmx.remove(container.children[i]);
						}
					}
					console.log("event swap top - overflow:", overflow)
				} else {
					htmx.swap(container, events, {swapStyle: "beforeend"}, {eventInfo: {isTop: isTop}});
					const overflow = container.children.length - maxEvents;
					if (overflow > 0) {
						for (let i = 0; i < overflow; i++) {
							htmx.remove(container.children[i]);
						}
					}
					console.log("event swap bottom - overflow:", overflow)
				}
			},

			addParamsToURL(url) {
				const elem = htmx.find("#includes");
				const params = new URLSearchParams(htmx.values(elem).entries());
				return url + "?" + params.toString();
			},

			shouldLoadTop() {
				const container = document.getElementById("events-container");
				return container.scrollTop <= container.scrollHeight * 0.2;
			},

			shouldLoadBottom() {
				const container = document.getElementById("events-container");
				return container.scrollTop + container.offsetHeight >= container.scrollHeight * 0.8;
			},

			getTopTimestamp() {
				const events = htmx.findAll(htmx.find("#events"), ".event");
				if (events.length > 0) {
					return htmx.find(events[0], "input").value;
				} else {
					return "";
				}
			},

			getBottomTimestamp() {
				const events = htmx.findAll(htmx.find("#events"), ".event");
				if (events.length > 0) {
					return htmx.find(events[events.length-1], "input").value;
				} else {
					return "";
				}
			},

			handleScroll() {
				const container = document.getElementById("events-container");
				if (container.scrollTop < this.scrollTop) {
					this.fetch(true);
				} else if (container.scrollTop > this.scrollTop) {
					this.fetch(false);
				}
			},

			url: "",
			moreTop: false,
			moreBottom: true,
			newEvents: false,
			nextIsTop: true,
			intervalID: 0,
			eventSource: null,
			scrollTop: 0,
			status: null,
		}` }
		@scroll="$data.handleScroll()"
	>
		<input id="project-url" type="hidden" value={ common.FormatProjectUrl(ctx) }/>
		<table id="events-table" class="table table-pin-rows table-sm">
			<thead>
				<tr class="cursor-default">
					<th>Timestamp</th>
					<th>Type</th>
					<th>Sender</th>
					<th>Level</th>
					<th>Message</th>
				</tr>
			</thead>
			<tbody id="events"></tbody>
		</table>
		<div id="events-spinner" class="spinner absolute flex top-0 w-full h-full items-center justify-center">
			<span class="loading loading-dots loading-lg"></span>
		</div>
	</div>
}

templ eventsFilter(filter gong_common.Filter) {
	<form
		id="events-filter"
		class="join w-fit mb-0"
		hx-get={ common.FormatProjectUrl(ctx) }
		hx-include={ common.Includes }
		hx-headers={ `{"View": "actor"}` }
		hx-trigger="submit"
		hx-swap="none"
		hx-push-url="true"
	>
		<script>
			function updateFilter() {
				console.log("updateFilter()");
				const inputs = document.getElementById('events-filter').querySelectorAll("input");
				for (const input of inputs) {
					if (input.value !== input.defaultValue || input.checked !== input.defaultChecked) {
						htmx.trigger('#events-filter', 'submit', {});
					}
				}
			}
		</script>
		@eventsFilterItem("Type", gong_common.ParamFilterType, filter.Type != nil, -1) {
			<input
				class="event-filter-input"
				name={ gong_common.ParamFilterType }
				type="text"
				placeholder="actor.Started"
				if filter.Type != nil {
					value={ *filter.Type }
				}
			/>
		}
		@eventsFilterItem("Sender", gong_common.ParamFilterSender, filter.Sender != nil, 0) {
			<input
				class="event-filter-input"
				name={ gong_common.ParamFilterSender }
				type="text"
				placeholder="local/server/primary"
				if filter.Sender != nil {
					value={ *filter.Sender }
				}
			/>
		}
		@eventsFilterItem("Level", gong_common.ParamFilterLevel, filter.Level != nil, 1) {
			<div class="px-2 py-1">
				@eventsFilterLevelOption("DEBUG", slog.LevelDebug, filter.Level)
				@eventsFilterLevelOption("INFO", slog.LevelInfo, filter.Level)
				@eventsFilterLevelOption("WARN", slog.LevelWarn, filter.Level)
				@eventsFilterLevelOption("ERROR", slog.LevelError, filter.Level)
			</div>
		}
	</form>
}

templ eventsFilterLevelOption(label string, level slog.Level, selected *slog.Level) {
	<div class="form-control">
		<label class="label cursor-pointer py-1">
			<span class="label-text">{ label }</span>
			<input
				type="radio"
				name={ gong_common.ParamFilterLevel }
				class="radio"
				value={ strconv.Itoa(int(level)) }
				if selected != nil && *selected == level {
					checked
				}
			/>
		</label>
	</div>
}

templ eventsFilterItem(label string, name string, active bool, placement int) {
	<div class="join-item indicator">
		if active {
			<span
				class="indicator-item badge badge-info badge-sm cursor-pointer pl-0 pr-0"
				hx-get={ common.FormatProjectUrl(ctx) }
				hx-include={ common.Includes }
				hx-params={ "not " + name }
				hx-headers={ `{"View": "actor"}` }
				hx-trigger="click"
				hx-swap="none"
				hx-push-url="true"
			>
				@common.CloseIcon("inline-block w-4 h-4 stroke-current")
			</span>
		}
		<div class="dropdown group/filter">
			<div
				tabindex="0"
				role="button"
				class={ "event-filter-button-container", templ.KV("rounded-l", placement < 0), templ.KV("rounded-r", placement > 0) }
			>
				<div class={ "event-filter-button", templ.KV("bg-neutral text-neutral-content", active) }>{ label }</div>
			</div>
			<div
				tabindex="0"
				class="dropdown-content z-50 shadow bg-base-100 rounded-lg rounded-tl-none w-64 border"
				@focusout="if (!$el.contains($event.relatedTarget)) { updateFilter() }"
				@keydown.enter="updateFilter()"
			>
				{ children... }
			</div>
		</div>
	</div>
}

func formatActorPIDCtx(ctx context.Context) string {
	if pid, ok := ctx.Value(gong_common.CtxPID).(string); ok {
		return formatActorPID(pid)
	}
	return ""
}

func formatActorPID(pid string) string {
	return strings.ReplaceAll(pid, "/", "-")
}

templ ProjectActorEvents(events gong_common.EventList, appendTop bool, moreTop bool, moreBottom bool) {
	for i := len(events)-1; i >= 0; i-- {
		@projectActorEvent(events[i])
	}
}

templ projectActorEvent(event gong_common.Event) {
	<tr id={ fmt.Sprintf("event-%s", strconv.Itoa(int(event.Timestamp.UnixNano()))) } class="event">
		<input type="hidden" value={ strconv.Itoa(int(event.Timestamp.UnixNano())) }/>
		<td>
			{ event.Timestamp.String() }
		</td>
		<td>
			{ event.Type }
		</td>
		<td>
			if event.Sender != "" {
				{ event.Sender }
			} else {
				N/A
			}
		</td>
		<td>
			{ event.SlogLevel().String() }
		</td>
		<td>
			if event.Msg != "" {
				{ event.Msg }
			} else {
				N/A
			}
		</td>
	</tr>
}
