package project

import (
	"context"
	"fmt"
	"log/slog"
	"stagebase/internal/common"
	commonView "stagebase/internal/view/common"
	"strconv"
	"time"
)

const (
	idTimeStart    = "time-start"
	idEventsFilter = "events-filter"
	idPageIndex    = "page-index"
)

var eventTableIncludes = []string{
	idTimeStart,
	idEventsFilter,
	idPageIndex,
}

func EventContentComponent(ctx context.Context) templ.Component {
	app := common.MustCtxApp(ctx)
	projectID := common.MustCtxProjectID(ctx)
	actorPID := common.MustCtxActorPID(ctx)
	filter, _ := common.CtxFilter(ctx)
	pageIdx, _ := common.CtxPageIndex(ctx)
	timeStart, ok := common.CtxTimeStart(ctx)
	if !ok {
		actor, err := app.Actor(ctx, projectID, actorPID)
		if err != nil {
			return nil
		}
		timeStart = actor.LastEventTime
	}
	return eventContentComponent(filter, timeStart, pageIdx)
}

templ eventContentComponent(filter common.Filter, timeStart time.Time, pageIdx int) {
	<div class="flex flex-row w-full h-fit px-4 py-2 border-b border-color items-center justify-between">
		@eventsFilter(filter)
		@eventTablePaginationControl(pageIdx, 0)
	</div>
	<div
		id="events-container"
		class="relative flex flex-col grow min-h-0 max-w-full overflow-x-auto"
		hx-ext="sse"
	>
		<input id="project-url" type="hidden" value={ commonView.FormatProjectUrl(ctx) }/>
		<input include id="time-start" type="hidden" name={ common.ParamTimeStart } value={ strconv.FormatInt(timeStart.UnixNano(), 10) }/>
		<input include id="page-index" type="hidden" name={ common.ParamPageIndex } value={ strconv.Itoa(pageIdx) }/>
		@EventTableComponent(true)
		<div id="events-spinner" class="htmx-indicator absolute flex w-full h-full items-center justify-center">
			<span class="loading loading-spinner w-16"></span>
		</div>
	</div>
}

templ eventTablePaginationControl(pageIndex int, maxPageIndex int) {
	<div id="pagination-controls" hx-swap-oob="true" class="join">
		@eventTablePaginationControlItem(pageIndex, 0, 0) {
			@commonView.DoubleArrowIcon("")
		}
		@eventTablePaginationControlItem(pageIndex, pageIndex-1, 0) {
			@commonView.ArrowIcon("")
		}
		<div class="join-item button-sm w-fit min-w-8 !text-base-content" disabled>
			{ strconv.Itoa(pageIndex) }
		</div>
		@eventTablePaginationControlItem(pageIndex, pageIndex+1, maxPageIndex) {
			@commonView.ArrowIcon("rotate-180")
		}
		@eventTablePaginationControlItem(pageIndex, maxPageIndex, maxPageIndex) {
			@commonView.DoubleArrowIcon("rotate-180")
		}
	</div>
}

templ eventTablePaginationControlItem(page int, nextPage int, disableOnPage int) {
	<button
		class="join-item button-sm fill-base-content disabled:fill-base-content/50"
		hx-get={ commonView.FormatProjectUrl(ctx) }
		hx-include={ commonView.BuildIncludes(commonView.StandardIncludes, eventTableIncludes) }
		hx-headers={ `{"View": "actor"}` }
		hx-vals={ fmt.Sprintf(`{"%s": "%d"}`, common.ParamPageIndex, nextPage) }
		hx-trigger="click"
		hx-swap="none"
		hx-push-url="true"
		if page == disableOnPage {
			disabled
		}
	>
		{ children... }
	</button>
}

templ eventsFilter(filter common.Filter) {
	<form
		id={ idEventsFilter }
		class="join w-fit mb-0"
		hx-get={ commonView.FormatProjectUrl(ctx) }
		hx-include={ commonView.BuildIncludes(commonView.StandardIncludes, eventTableIncludes) }
		hx-headers={ `{"View": "actor"}` }
		hx-trigger="submit"
		hx-swap="none"
		hx-push-url="true"
	>
		<script>
			function updateFilter() {
				console.log("updateFilter()");
				const inputs = document.getElementById('events-filter').querySelectorAll("input");
				for (const input of inputs) {
					if (input.value !== input.defaultValue || input.checked !== input.defaultChecked) {
						htmx.trigger('#events-filter', 'submit', {});
					}
				}
			}
		</script>
		@eventsFilterItem("Type", common.ParamFilterType, filter.Type != nil, -1) {
			<input
				class="event-filter-input"
				name={ common.ParamFilterType }
				type="text"
				placeholder="actor.Started"
				if filter.Type != nil {
					value={ *filter.Type }
				}
			/>
		}
		@eventsFilterItem("Sender", common.ParamFilterSender, filter.Sender != nil, 0) {
			<input
				class="event-filter-input"
				name={ common.ParamFilterSender }
				type="text"
				placeholder="local/server/primary"
				if filter.Sender != nil {
					value={ *filter.Sender }
				}
			/>
		}
		@eventsFilterItem("Level", common.ParamFilterLevel, filter.Level > slog.LevelDebug, 1) {
			<div class="px-2 py-1">
				@eventsFilterLevelOption("DEBUG", slog.LevelDebug, filter.Level)
				@eventsFilterLevelOption("INFO", slog.LevelInfo, filter.Level)
				@eventsFilterLevelOption("WARN", slog.LevelWarn, filter.Level)
				@eventsFilterLevelOption("ERROR", slog.LevelError, filter.Level)
			</div>
		}
	</form>
}

templ eventsFilterLevelOption(label string, level slog.Level, selected slog.Level) {
	<div class="form-control">
		<label class="label cursor-pointer py-1">
			<span class="label-text">{ label }</span>
			<input
				type="radio"
				name={ common.ParamFilterLevel }
				class="radio"
				value={ strconv.Itoa(int(level)) }
				if selected == level {
					checked
				}
			/>
		</label>
	</div>
}

templ eventsFilterItem(label string, name string, active bool, placement int) {
	<div class="join-item indicator">
		if active {
			<span
				class="indicator-item badge badge-info badge-sm cursor-pointer pl-0 pr-0"
				hx-get={ commonView.FormatProjectUrl(ctx) }
				hx-include={ commonView.BuildIncludes(commonView.StandardIncludes, eventTableIncludes) }
				hx-params={ "not " + name }
				hx-headers={ `{"View": "actor"}` }
				hx-trigger="click"
				hx-swap="none"
				hx-push-url="true"
			>
				@commonView.CloseIcon("inline-block w-4 h-4 stroke-current")
			</span>
		}
		<div class="dropdown group/filter">
			<div
				tabindex="0"
				role="button"
				class={ "event-filter-button-container", templ.KV("rounded-l", placement < 0), templ.KV("rounded-r", placement > 0) }
			>
				<div class={ "event-filter-button", templ.KV("bg-neutral text-neutral-content", active) }>{ label }</div>
			</div>
			<div
				tabindex="0"
				class="dropdown-content z-50 shadow bg-base-200 rounded-lg rounded-tl-none w-64 border border-color"
				@focusout="if (!$el.contains($event.relatedTarget)) { updateFilter() }"
				@keydown.enter="updateFilter()"
			>
				{ children... }
			</div>
		</div>
	</div>
}

templ EventTableComponent(lazy bool) {
	@eventTableComponent(ctx, lazy)
}

func eventTableComponent(ctx context.Context, lazy bool) templ.Component {
	app := common.MustCtxApp(ctx)
	projectID := common.MustCtxProjectID(ctx)
	actorPID := common.MustCtxActorPID(ctx)
	timeStart, _ := common.CtxTimeStart(ctx)
	pageIdx, _ := common.CtxPageIndex(ctx)
	filter, _ := common.CtxFilter(ctx)

	events := []common.Event{}
	maxPageIdx := 0

	if !lazy {
		var err error
		events, maxPageIdx, err = app.Events(ctx, projectID, actorPID, timeStart, filter, pageIdx)
		if err != nil {
			events = []common.Event{}
		}
	}

	return eventTable(events, lazy, pageIdx, maxPageIdx)
}

templ eventTable(events common.EventList, lazy bool, pageIdx int, maxPageIdx int) {
	<table
		class="table table-pin-rows table-sm"
		if lazy {
			hx-get={ commonView.FormatProjectUrl(ctx) + "/events" }
			hx-trigger="load"
			hx-include={ commonView.BuildIncludes(commonView.StandardIncludes, eventTableIncludes) }
			hx-indicator="#events-spinner"
			hx-swap="outerHTML"
		}
	>
		<thead>
			<tr class="cursor-default">
				<th>Timestamp</th>
				<th>Type</th>
				<th>Sender</th>
				<th>Level</th>
				<th>Message</th>
			</tr>
		</thead>
		if lazy || len(events) > 0 {
			<tbody>
				for _, event := range events {
					<tr id={ fmt.Sprintf("event-%s", strconv.Itoa(int(event.Timestamp.UnixNano()))) } class="event">
						<input type="hidden" value={ strconv.Itoa(int(event.Timestamp.UnixNano())) }/>
						<td>
							{ event.Timestamp.String() }
						</td>
						<td>
							{ event.Type }
						</td>
						<td>
							if event.Sender != "" {
								{ event.Sender }
							} else {
								N/A
							}
						</td>
						<td>
							{ event.SlogLevel().String() }
						</td>
						<td>
							if event.Msg != "" {
								{ event.Msg }
							} else {
								N/A
							}
						</td>
					</tr>
				}
			</tbody>
		}
	</table>
	if !lazy && len(events) == 0 {
		<div class="flex flex-col grow min-h-0 items-center justify-center">
			@commonView.DataErrorIcon("w-24 h-24")
			<div class="text-2xl">No events found</div>
			<div class="">No events match the selected filters</div>
		</div>
	}
	if !lazy {
		@eventTablePaginationControl(pageIdx, maxPageIdx)
	}
}
