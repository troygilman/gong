package project

import (
	"context"
	"errors"
	"fmt"
	"stagebase/internal/api/view/graph"
	"stagebase/internal/api/view/timefilter"
	"stagebase/internal/common"
	commonView "stagebase/internal/view/common"
	"time"
)

templ FlowTabContent() {
	<div id="actor-flow-chart-widget" class="flex flex-col grow max-w-full min-h-0">
		<div class="flex flex-row items-center border-b border-color py-2 px-4 gap-2 w-full">
			@flowChartFilterType(ctx)
			@timefilter.FromCtx(ctx).Component(commonView.FormatProjectUrl(ctx), common.ProjectViewFlowChart)
		</div>
		<div class="grid grid-cols-3 grow w-full min-h-0">
			@graph.Component(true, commonView.FormatProjectUrl(ctx))
			@FlowChartNodeInfoComponent(ctx, true)
		</div>
	</div>
}

func flowChartFilterType(ctx context.Context) templ.Component {
	if flow, ok := ctx.Value(common.CtxKeyFlow).(string); ok {
		return flowChartFilterTypeComponent(flow)
	}
	return flowChartFilterTypeComponent("Sources")
}

templ flowChartFilterTypeComponent(flow string) {
	<div role="tablist" class="tabs tabs-boxed tabs-sm border border-color">
		<input include id="flow" type="hidden" name={ common.ParamFlow } value={ flow }/>
		@flowChartFilterTypeItem("Sources", flow)
		@flowChartFilterTypeItem("Sinks", flow)
	</div>
}

templ flowChartFilterTypeItem(label string, active string) {
	<a
		role="tab"
		class={ "tab", templ.KV("tab-active !bg-neutral !text-neutral-content", label == active) }
		if label != active {
			hx-get={ commonView.FormatProjectUrl(ctx) }
			hx-headers={ fmt.Sprintf(`{"View": "%s"}`, common.ProjectViewFlowChart) }
			hx-vals={ fmt.Sprintf(`{"%s": "%s"}`, common.CtxKeyFlow, label) }
			hx-include={ commonView.BuildIncludes(commonView.StandardIncludes) }
			hx-push-url="true"
			hx-trigger="click"
			hx-target="#actor-flow-chart-widget"
			hx-swap="outerHTML"
		}
	>{ label }</a>
}

func FlowChartNodeInfoComponent(ctx context.Context, lazy bool) templ.Component {
	if lazy {
		node, _ := ctx.Value(common.CtxKeyFlowNode).(string)
		return flowChartNodeInfoEmptyComponent(node)
	}

	app := common.MustCtxApp(ctx)
	projectID := common.MustCtxProjectID(ctx)
	actorPID := common.MustCtxActorPID(ctx)

	nodePID, ok := ctx.Value(common.CtxKeyFlowNode).(string)
	if !ok {
		panic("flow_node is empty")
	}

	flowType, ok := ctx.Value(common.CtxKeyFlow).(string)
	if !ok {
		panic("flow is missing")
	}

	source, err := isSources(flowType)
	if err != nil {
		panic(err.Error())
	}

	timeFilter := timefilter.FromCtx(ctx)

	nodeInfo, err := app.Database().QuerySourcesSinksNodeInfo(ctx, common.SourcesSinksNodeInfoQuery{
		Source:    source,
		ProjectID: projectID,
		ActorPID:  actorPID,
		NodePID:   nodePID,
		MinTime:   timeFilter.Time(),
		MaxTime:   time.Now(),
	})
	if err != nil {
		panic(err.Error())
	}

	if nodeInfo.MsgCount == 0 {
		return flowChartNodeInfoComponent(nodeInfo)
	}
	return flowChartNodeInfoComponent(nodeInfo)
}

func isSources(flowType string) (bool, error) {
	switch flowType {
	case "Sources":
		return true, nil
	case "Sinks":
		return false, nil
	default:
		return false, errors.New("invalid flow type")
	}
}

templ flowChartNodeInfoEmptyComponent(node string) {
	<div
		id="node-info-container"
		class="relative flex grow w-full min-h-0 items-center justify-center"
		hx-get={ commonView.FormatProjectUrl(ctx) }
		hx-headers={ fmt.Sprintf(`{"View": "%s"}`, common.ProjectViewFlowChartNodeInfo) }
		hx-include={ commonView.BuildIncludes(commonView.StandardIncludes) }
		hx-vals={ fmt.Sprintf(`js:{"%s": getNode(event)}`, common.ParamFlowNode) }
		hx-target="#node-info"
		hx-swap="outerHTML"
		hx-push-url="true"
		if node != "" {
			hx-trigger="fetch-content, load"
		} else {
			hx-trigger="fetch-content"
		}
		@htmx:before-request={ "htmx.addClass(htmx.find('#node-info'), 'hidden')" }
	>
		<script>
			function getNode(event) {
				if (event && event.detail && event.detail.node) {
					return event.detail.node;
				} else {
					return document.getElementById("flow-node").value;
				}
			}
		</script>
		@flowChartNodeState(node)
		<div id="node-info" class="w-full h-full flex items-center justify-center">
			Select a source/sink
		</div>
		<span class="absolute htmx-indicator loading loading-spinner w-16"></span>
	</div>
}

templ flowChartNodeInfoComponent(info common.SourcesSinksNodeInfo) {
	<div id="node-info" class="flex flex-col w-full h-full p-2">
		@flowChartNodeState(info.PID)
		<div class="stats stats-vertical border border-color">
			<div class="stat">
				<div class="stat-title">PID</div>
				<div class="stat-value">{ info.PID }</div>
				<div class="stat-desc">nice</div>
			</div>
			<div class="stat">
				<div class="stat-title">Events</div>
				<div class="stat-value">{  fmt.Sprintf("%d", info.MsgCount) }</div>
				<div class="stat-desc">nice</div>
			</div>
		</div>
	</div>
}

templ flowChartNodeState(node string) {
	<input include id="flow-node" name={ common.ParamFlowNode } type="hidden" value={ node }/>
}
