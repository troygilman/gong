package project

import (
	"context"
	"fmt"
	"golang.org/x/text/language"
	"golang.org/x/text/message"
	gong_common "gong/internal/common"
	"gong/internal/view/common"
	"log"
)

templ FlowTabContent() {
	<div id="actor-flow-chart-widget" class="flex flex-col grow max-w-full min-h-0">
		<div class="flex flex-row items-center border-b border-color py-2 px-4 gap-2 w-full">
			@flowChartFilterType(ctx)
			@flowChartFilterRange(ctx)
		</div>
		<div class="grid grid-cols-3 grow w-full min-h-0">
			<div
				hx-get={ common.FormatProjectUrl(ctx) + "/chart" }
				hx-trigger="load"
				hx-include={ common.Includes }
				class="flex w-full h-full max-h-full items-center justify-center bg-base-200 overflow-hidden col-span-2 border-r border-color"
			>
				<span class="loading loading-dots loading-lg"></span>
			</div>
			@flowChartNodeInfo(ctx)
		</div>
	</div>
}

func flowChartFilterRange(ctx context.Context) templ.Component {
	if rng, ok := ctx.Value(gong_common.CtxKeyFlowRange).(gong_common.Range); ok {
		return flowChartFilterRangeComponent(rng)
	}
	return flowChartFilterRangeComponent(gong_common.Range(1))
}

templ flowChartFilterRangeComponent(rng gong_common.Range) {
	<button class="btn btn-sm btn-square no-animation border border-color p-1" onclick="my_modal_1.showModal()">
		@common.DateIcon("")
	</button>
	<dialog id="my_modal_1" class="modal">
		<form method="dialog" class="modal-backdrop">
			<button></button>
		</form>
		<div class="modal-box">
			<form method="dialog">
				Lookback Range
				<button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
			</form>
			<div
				class="flex flex-col w-full"
				hx-get={ common.FormatProjectUrl(ctx) }
				hx-headers={ fmt.Sprintf(`{"View": "%s"}`, gong_common.ProjectViewFlowChart) }
				hx-include={ common.Includes }
				hx-push-url="true"
				hx-trigger="flow-chart-filter-range-submit"
				hx-target="#actor-flow-chart-widget"
				hx-swap="outerHTML"
			>
				<div class="bg-base-200 border border-color rounded py-2 px-4">
					<input type="range" id="flow-range" name="flow_range" min="0" max="4" value={ rng.String() } step="1" class="range range-xs rotate-180 [--range-shdw:oklch(var(--n))]"/>
					<div class="flex w-full justify-between px-2 pb-4 text-xs">
						<div class="relative">|<div class="absolute -left-4 text-nowrap">1 Month</div></div>
						<div class="relative">|<div class="absolute -left-4 text-nowrap">1 Week</div></div>
						<div class="relative">|<div class="absolute -left-4 text-nowrap">1 Day</div></div>
						<div class="relative">|<div class="absolute -left-4 text-nowrap">1 Hour</div></div>
						<div class="relative">|<div class="absolute -left-4 text-nowrap">1 Min</div></div>
					</div>
				</div>
				<div class="flex flex-row justify-end pt-4">
					<div
						class="btn btn-sm border border-color"
						@click="$dispatch('flow-chart-filter-range-submit')"
					>
						Ok
					</div>
				</div>
			</div>
		</div>
	</dialog>
}

func flowChartFilterType(ctx context.Context) templ.Component {
	if flow, ok := ctx.Value(gong_common.CtxKeyFlow).(string); ok {
		return flowChartFilterTypeComponent(flow)
	}
	return flowChartFilterTypeComponent("Sources")
}

templ flowChartFilterTypeComponent(flow string) {
	<div role="tablist" class="tabs tabs-boxed tabs-sm border border-color">
		<input id="flow" type="hidden" name={ gong_common.ParamFlow } value={ flow }/>
		@flowChartFilterTypeItem("Sources", flow)
		@flowChartFilterTypeItem("Sinks", flow)
	</div>
}

templ flowChartFilterTypeItem(label string, active string) {
	<a
		role="tab"
		class={ "tab", templ.KV("tab-active !bg-neutral !text-neutral-content", label == active) }
		if label != active {
			hx-get={ common.FormatProjectUrl(ctx) }
			hx-headers={ fmt.Sprintf(`{"View": "%s"}`, gong_common.ProjectViewFlowChart) }
			hx-vals={ fmt.Sprintf(`{"%s": "%s"}`, gong_common.CtxKeyFlow, label) }
			hx-include={ common.Includes }
			hx-push-url="true"
			hx-trigger="click"
			hx-target="#actor-flow-chart-widget"
			hx-swap="outerHTML"
		}
	>{ label }</a>
}

func flowChartNodeInfo(ctx context.Context) templ.Component {
	if node, ok := ctx.Value(gong_common.CtxKeyFlowNode).(string); ok {
		log.Println("flowChartNodeInfo: node found", node)
		return flowChartNodeInfoComponent(node)
	}
	log.Println("flowChartNodeInfo: node not found")
	return flowChartNodeInfoComponent("")
}

templ flowChartNodeInfoComponent(node string) {
	<div
		id="node-info-container"
		class="relative flex grow w-full min-h-0 items-center justify-center"
		hx-get={ common.FormatProjectUrl(ctx) }
		hx-headers={ fmt.Sprintf(`{"View": "%s"}`, gong_common.ProjectViewFlowChartNodeInfo) }
		hx-include={ common.Includes }
		hx-vals={ fmt.Sprintf(`js:{"%s": getNode(event)}`, gong_common.ParamFlowNode) }
		hx-target="#node-info"
		hx-swap="outerHTML"
		hx-push-url="true"
		if node != "" {
			hx-trigger="fetch-content, load"
		} else {
			hx-trigger="fetch-content"
		}
		@htmx:before-request={ "htmx.addClass(htmx.find('#node-info'), 'hidden')" }
	>
		<script>
			function getNode(event) {
				if (event && event.detail && event.detail.node) {
					return event.detail.node;
				} else {
					return document.getElementById("flow-node").value;
				}
			}
		</script>
		@FlowChartNodeInfoContentEmpty(node)
		<span class="absolute htmx-indicator loading loading-dots loading-lg"></span>
	</div>
}

templ FlowChartNodeInfoContent(info gong_common.SourcesSinksNodeInfo) {
	<div id="node-info" class="flex flex-col w-full h-full p-2">
		@flowChartNodeState(info.PID)
		<div class="stats stats-vertical border border-color">
			<div class="stat">
				<div class="stat-title">PID</div>
				<div class="stat-value">{ info.PID }</div>
				<div class="stat-desc">nice</div>
			</div>
			<div class="stat">
				<div class="stat-title">Events</div>
				<div class="stat-value">{  message.NewPrinter(language.English).Sprintf("%d", info.MsgCount) }</div>
				<div class="stat-desc">nice</div>
			</div>
		</div>
	</div>
}

templ FlowChartNodeInfoContentEmpty(node string) {
	<div id="node-info" class="w-full h-full flex items-center justify-center">
		@flowChartNodeState(node)
		Select a source/sink
	</div>
}

templ flowChartNodeState(node string) {
	<input id="flow-node" name={ gong_common.ParamFlowNode } type="hidden" value={ node }/>
}

templ FlowChart(sourcesSinks []string, flowType string) {
	<div class="flex relative h-full w-full items-center justify-center">
		<div class="flex flex-col absolute top-4 left-4 px-2 py-1 bg-base-300 border border-color rounded shadow text-sm cursor-default">
			<div class="flex items-center justify-start">
				<div class="badge badge-primary badge-sm mr-2"></div>
				Actor
			</div>
			<div class="flex items-center justify-start">
				<div class="badge badge-accent badge-sm mr-2"></div>
				{ flowType }
			</div>
		</div>
		<svg id="chart" class="w-full h-full" preserveAspectRatio="xMidYMid slice"></svg>
		if actorPID, ok := ctx.Value(gong_common.CtxKeyPID).(string); ok {
			@initFlowChart(actorPID, sourcesSinks, flowType == "Sources")
		}
	</div>
}

script initFlowChart(actorPID string, sourcesSinks []string, isSources bool) {
	const width = 1000;
	const height =  1000;
	const circleRadius = 12;
	const circleRadiusHover = 14;

	let data = {
		"nodes": [
			{"id": actorPID, "group": 1},
		],
		"links": [],
	}

	for (let i = 0; i < sourcesSinks.length; i++) {
		let pid = sourcesSinks[i];
		data.nodes.push({"id": pid, "group": 2});
		data.links.push({"source": pid, "target": actorPID, "value": 1});
	};

	// Specify the color scale.
	const color = d3.scaleOrdinal(d3.schemeCategory10);

	// The force simulation mutates links and nodes, so create a copy
	// so that re-evaluating this cell produces the same result.
	const links = data.links.map(d => ({...d}));
	const nodes = data.nodes.map(d => ({...d}));

	// Create a simulation with several forces.
	const simulation = d3.forceSimulation(nodes)
		.force("link", d3.forceLink(links).id(d => d.id).distance(300))
	    .force("charge", d3.forceManyBody().strength(-10000))
	    .force("center", d3.forceCenter(width / 2, height / 2))
		.velocityDecay(0.2)
	    .on("tick", ticked);


	const zoom = d3.zoom().on("zoom", handleZoom);

	// Create the SVG container.
	const svg = d3.select("#chart")
	    .attr("viewBox", [0, 0, width, height])
		.call(zoom);

	const defs = svg.append("defs")
	
	const arrow = defs.append("marker")
      	.attr("id", "arrow")
       	.attr("viewBox", "0 -5 10 10")
        .attr("refX", 16)
        .attr("refY", -0.5)
        .attr("markerWidth", 5)
        .attr("markerHeight", 5)
        .attr("orient", "auto")
        .append("path")
		.attr("stroke-width", 2)
		.attr("stroke", "oklch(var(--b2))")
        .attr("fill", "oklch(var(--bc))")
        .attr("d", "M0,-5L10,0L0,5");

	var filter = defs.append("filter")
		.attr("id", "glow")
		.attr("x", "-50%")  // Expand the filter area horizontally
		.attr("y", "-50%")  // Expand the filter area vertically
		.attr("width", "200%")  // Increase width of the filter area
		.attr("height", "200%")  // Increase height of the filter area
		.attr("filterUnits", "objectBoundingBox");  // Make sure the filter applies to the entire object
	filter.append("feGaussianBlur")
		.attr("stdDeviation", "2.5")
		.attr("result", "coloredBlur");
	var feMerge = filter.append("feMerge");
	feMerge.append("feMergeNode")
		.attr("in", "coloredBlur");
	feMerge.append("feMergeNode")
		.attr("in", "SourceGraphic");

	const link = svg.append("g")
		.attr("id", "links")
    	.attr("fill", "none")
     	.attr("stroke-width", 4)
		.attr("opacity", 0.2)
      	.selectAll("path")
       	.data(links)
        .join("path")
        .attr("stroke", "oklch(var(--bc))")
        .attr("marker-end", "url(#arrow)");

  	const node = svg.append("g")
		.attr("id", "nodes")
       	.selectAll("g")
        .data(nodes)
        .join("g");

	node.append("circle")
		.attr("stroke-width", 10)
		.attr("stroke", "oklch(var(--b2))")
		.attr("r", circleRadius);

	node.append("circle")
		.attr("class", d => {
			if (d.group == 2) {
				return "cursor-pointer";
			}
		})
        .attr("r", circleRadius)
        .attr("fill", d => {
        	if (d.group == 1) {
         		return "oklch(var(--p))";
         	} else {
          		return "oklch(var(--a))";
          	}
        })
		.style("filter", "url(#glow)")
        .on("mouseover", (e, d) => { if (d.group == 2) { d3.select(e.target).attr("r", circleRadiusHover) }})
        .on("mouseleave", (e, d) => { if (d.group == 2) { d3.select(e.target).attr("r", circleRadius) }})
        .on("click", (e, d) => { if (d.group == 2) { htmx.trigger("#node-info-container", "fetch-content", { node: d.id }) }});

	node.append("text")
      	.attr("x", 16)
      	.attr("y", "0.31em")
	  	.attr("stroke-width", 0)
	  	.attr("class", "text-lg font-medium cursor-default")
		.attr("fill", "oklch(var(--bc))")
      	.text(d => d.id)
    	.clone(true).lower()
      	.attr("fill", "none")
      	.attr("stroke", "oklch(var(--b2))")
      	.attr("stroke-width", 4);

function linkArc(d) {
    var node1 = d.source;
    var node2 = d.target;

    if (!isSources) {
        node1 = d.target;
        node2 = d.source;
    }

    // Calculate distances and midpoints
    const dx = node2.x - node1.x;
    const dy = node2.y - node1.y;
    const distance = Math.sqrt(dx * dx + dy * dy);
    
    const curvature = 0.4; // Adjust this factor to control the curve

    // Midpoint
    const midX = (node1.x + node2.x) / 2;
    const midY = (node1.y + node2.y) / 2;

    // Control point calculation for smooth curve
    const controlX = midX + curvature * distance * (dy / distance);
    const controlY = midY - curvature * distance * (dx / distance);

    // Create a smooth curve using a quadratic Bézier curve
    return `
        M${node1.x},${node1.y}
        Q${controlX},${controlY} ${node2.x},${node2.y}
    `;
}

    // Set the position attributes of links and nodes each time the simulation ticks.
    function ticked() {
    	link.attr("d", linkArc);
        node.attr("transform", d => {
			return `translate(${d.x},${d.y})`
		});
    };

    function handleZoom(e) {
    	svg.select("#nodes")
     		.attr("transform", d => {
				return e.transform;
			});
    	svg.select("#links")
     		.attr("transform", d => {
				return e.transform;
			});
    }
}
