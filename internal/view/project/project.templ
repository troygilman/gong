package project

import (
	"context"
	"fmt"
	"github.com/google/uuid"
	gong_common "gong/internal/common"
	"gong/internal/view/common"
)

templ Project(props gong_common.ProjectProps) {
	@common.Index() {
		<div id="includes" hx-include={ buildIncludeString(common.StandardIncludes) }></div>
		<script>
			const next = htmx.createEventSource;
			htmx.createEventSource = function(url) {
				const elem = htmx.find("#includes");
				const params = new URLSearchParams(htmx.values(elem).entries());
				url = url + "?" + params.toString();
				return next(url);
			}
		</script>
		<div
			class="flex flex-row h-screen w-screen max-h-screen max-w-screen font-medium"
			hx-ext="sse"
			sse-connect={ "/project/" + props.ID.String() + "/sse/project" }
			x-data
		>
			<div class="flex flex-col w-12 min-w-12 border-r border-color p-2 gap-4 items-center justify-between z-50 bg-base-100">
				@common.LogoIcon("stroke-base-content")
				<div class="btn btn-circle btn-ghost btn-sm p-1" @click="state = document.getElementById('drawer-state'); state.checked = !state.checked">
					<div class="w-full h-full group-has-[.drawer-state:checked]/index:rotate-90 transition-all duration-300 ease-in-out">
						@common.MenuIcon("stroke-base-content")
					</div>
				</div>
			</div>
			<div class="flex flex-row h-full grow min-w-0">
				<input id="drawer-state" type="checkbox" class="drawer-state"/>
				<div class="drawer-content w-56 max-w-56">
					<div class="grid grid-rows-2 border-r border-color p-2 gap-2 w-full max-w-full min-w-full h-full">
						@ProjectMenu(ctx)
						@ProjectActorList(props)
					</div>
				</div>
				<div class="flex grow min-w-0 h-full">
					if pid, ok := ctx.Value(gong_common.CtxKeyPID).(string); ok {
						@ActorContent(props.Actors[pid])
					} else {
						@ActorContent(gong_common.Actor{})
					}
				</div>
			</div>
		</div>
	}
}

func ProjectMenu(ctx context.Context) templ.Component {
	projectID := uuid.Nil
	if id, ok := ctx.Value(gong_common.CtxKeyProjectID).(uuid.UUID); ok {
		projectID = id
	}

	activeTab := tabLabelOverview
	if tab, ok := ctx.Value(gong_common.CtxKeyTab).(string); ok {
		activeTab = tab
	}

	return projectMenuComponent(projectID, activeTab)
}

templ projectMenuComponent(projectID uuid.UUID, activeTab string) {
	<div class="w-full max-w-full min-w-0">
		<div class="dropdown mb-4 w-full">
			<div tabindex="0" role="button" class="btn btn-ghost btn-sm no-animation w-full">
				<div class="truncate">
					{ projectID.String() }
				</div>
			</div>
			<ul tabindex="0" class="dropdown-content z-50 menu p-1 shadow bg-base-100 rounded-box w-full border border-color">
				<li><a>Item 1</a></li>
				<li><a>Item 2</a></li>
			</ul>
		</div>
		<ul id="project-menu" hx-swap-oob="true" class="menu menu-md p-0">
			@projectMenuItem(tabLabelOverview, activeTab == tabLabelOverview, common.StatsIcon("size-5", activeTab == tabLabelOverview))
			@projectMenuItem(tabLabelEvents, activeTab == tabLabelEvents, common.TableIcon("size-5", activeTab == tabLabelEvents))
			@projectMenuItem(tabLabelFlow, activeTab == tabLabelFlow, common.FlowIcon("size-5", activeTab == tabLabelFlow))
		</ul>
	</div>
}

templ projectMenuItem(label string, active bool, icon templ.Component) {
	<li
		class="max-w-full"
		if !active {
			hx-get={ common.FormatProjectUrl(ctx) }
			hx-headers={ fmt.Sprintf(`{"View": "%s"}`, gong_common.ProjectViewActor) }
			hx-vals={ fmt.Sprintf(`{"tab": "%s"}`, label) }
			hx-include={ buildIncludeString(common.StandardIncludes) }
			hx-push-url="true"
			hx-trigger="click"
			hx-swap="none"
		}
	>
		<a class={ templ.KV("active", active) }>
			@icon
			<div class="text-md">{ label }</div>
		</a>
	</li>
}

templ ProjectActorList(props gong_common.ProjectProps) {
	<div class="flex flex-col w-full max-w-full min-w-0 grow min-h-0 border border-color rounded">
		<div class="flex items-center pl-4 pt-4 cursor-default text-md font-bold">Actors</div>
		<ul
			id="actor-list"
			class="menu menu-sm mb-2"
			sse-swap={ gong_common.SseTypeNewActor }
			hx-swap="afterbegin"
			x-data="{ active: ''}"
		>
			for _, actor := range props.Actors {
				@ProjectActorListItem(actor, false)
			}
		</ul>
	</div>
}

func isCurrentPID(ctx context.Context, actorPID string) bool {
	if pid, ok := ctx.Value(gong_common.CtxKeyPID).(string); ok {
		return pid == actorPID
	}
	return false
}

script resetActiveListItem(id string) {
	console.log("reset", id)
	const activeElems = document.getElementById('actor-list').querySelectorAll('.active');
	for (const elem of activeElems) {
		if (elem.parentNode.id !== id) {
			elem.classList.remove('active');
			const scripts = elem.querySelectorAll('script');
			for (const script of scripts) {
				htmx.remove(script);
			}
		}
	}
}

templ ProjectActorListItem(actor gong_common.Actor, oob bool) {
	<li
		id={ "actor-list-item-" + formatActorPID(actor.PID) }
		class="max-w-full"
		hx-get={ common.FormatProjectUrl(ctx) }
		hx-headers={ fmt.Sprintf(`{"View": "%s"}`, gong_common.ProjectViewActor) }
		hx-vals={ fmt.Sprintf(`{"pid": "%s"}`, actor.PID) }
		hx-include={ buildIncludeString(common.StandardIncludes) }
		hx-trigger="click"
		hx-push-url="true"
		if oob {
			hx-swap-oob="true"
		}
	>
		<a
			class={ "flex flex-row items-center justify-between w-full cursor-pointer text-sm px-2", templ.KV("active", isCurrentPID(ctx, actor.PID)) }
		>
			<div class="grow min-w-0 mr-2 truncate">{ actor.PID }</div>
			@ProjectActorBadge(actor)
			if isCurrentPID(ctx, actor.PID) {
				@resetActiveListItem("actor-list-item-" + formatActorPID(actor.PID))
			}
		</a>
	</li>
}

templ ProjectActorBadge(actor gong_common.Actor) {
	<div
		class={ "badge",  templ.KV("badge-success", actor.Alive), templ.KV("badge-error", !actor.Alive) }
		sse-swap={ gong_common.SseTypeUpdateActorNumEvents + actor.PID }
		hx-target="this"
		hx-swap="outerHTML"
	>
		if actor.NumEvents > 999 {
			{ "999+" }
		} else {
			{ fmt.Sprintf("%d", actor.NumEvents) }
		}
	</div>
}

const (
	tabLabelOverview = "Overview"
	tabLabelEvents   = "Events"
	tabLabelFlow     = "Flow"
)

templ ProjectActor(actor gong_common.Actor) {
	@ActorContent(actor)
	@ProjectActorListItem(actor, true)
	@ProjectMenu(ctx)
}

templ ActorContent(actor gong_common.Actor) {
	<div
		id="actor-content"
		class="flex flex-col grow max-h-full min-h-full min-w-0"
		hx-swap-oob="true"
	>
		<input id="actor-pid" type="hidden" name={ gong_common.ParamPID } value={ actor.PID }/>
		<input id="tab" type="hidden" name={ gong_common.ParamTab } value={ ctx.Value(gong_common.CtxKeyTab).(string) }/>
		<div class="flex flex-row items-center h-12 min-h-12 px-4 py-2 text-xl font-bold border-b border-color">{ actor.PID }</div>
		@tabContent(tabLabelOverview) {
			@OverviewTabContent(actor)
		}
		@tabContent(tabLabelEvents) {
			@eventsTabContent(ctx)
		}
		@tabContent(tabLabelFlow) {
			@FlowTabContent()
		}
	</div>
}

templ tabContent(label string) {
	if activeTab, ok := ctx.Value(gong_common.CtxKeyTab).(string); ok && label == activeTab {
		<div
			class="flex flex-col grow min-h-0"
		>
			{ children... }
		</div>
	}
}
