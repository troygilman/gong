package view

import (
	"gong/common"
	"fmt"
)

templ ChartTooltip() {
	<div>
		Actor!!!
	</div>
}

templ ActorFlowChartWidget() {
	<div id="actor-flow-chart-widget" class="grid grid-cols-2 w-full border border-color rounded shadow">
		<div hx-get={ formatProjectUrl(ctx) + "/chart" } hx-trigger="load" hx-include={ includes } class="flex aspect-square items-center justify-center bg-base-200">
			@spinnerIcon("size-1/3 pointer-events-none animate-spin")
		</div>
		<div class="border-l border-color overflow-auto p-4">
			<div role="tablist" class="tabs tabs-boxed border border-color">
				if flow, ok := ctx.Value(common.CtxFlow).(string); ok {
					<input id="flow" type="hidden" name="flow" value={ flow }/>
					@actorFlowChartFilterItem("Sources", flow)
					@actorFlowChartFilterItem("Sinks", flow)
				}
			</div>
		</div>
	</div>
}

templ ActorFlowChart(sourcesSinks []string) {
	<div class="grow min-h-0 min-w-0">
		<svg id="chart" class="max-w-full max-h-full"></svg>
		<div
			id="tooltip"
			class="absolute hidden bg-base-300 border rounded"
			hx-get={ formatProjectUrl(ctx) + "/tooltip" }
			hx-trigger="fetch-content"
			hx-vals={ "js:{node: getNode(event)}" }
		>
			<script>
				function getNode(event) {
					if (event.type == "fetch-content") {
						return event.detail.node;
					}
				}
			</script>
		</div>
		if actorPID, ok := ctx.Value(common.CtxPID).(string); ok {
			if flowType, ok := ctx.Value(common.CtxFlow).(string); ok {
				@initActorFlowChart(actorPID, sourcesSinks, flowType == "Sources")
			}
		}
	</div>
}

templ actorFlowChartFilterItem(label string, active string) {
	<a
		role="tab"
		class={ "tab", templ.KV("tab-active !bg-neutral !text-neutral-content", label == active) }
		if label != active {
			hx-get={ formatProjectUrl(ctx) }
			hx-headers={ fmt.Sprintf(`{"View": "%s"}`, common.ProjectViewFlowChart) }
			hx-vals={ fmt.Sprintf(`{"%s": "%s"}`, common.CtxFlow, label) }
			hx-include={ includes }
			hx-push-url="true"
			hx-trigger="click"
			hx-target="#actor-flow-chart-widget"
			hx-swap="outerHTML"
		}
	>{ label }</a>
}

script initActorFlowChart(actorPID string, sourcesSinks []string, isSources bool) {
	const width = 1000;
	const height =  1000;
	const circleRadius = 12;
	const circleRadiusHover = 14;

	let data = {
		"nodes": [
			{"id": actorPID, "group": 1},
		],
		"links": [],
	}

	for (let i = 0; i < sourcesSinks.length; i++) {
		let pid = sourcesSinks[i];
		data.nodes.push({"id": pid, "group": 2});
		data.links.push({"source": pid, "target": actorPID, "value": 1});
	};

	// Specify the color scale.
	const color = d3.scaleOrdinal(d3.schemeCategory10);

	// The force simulation mutates links and nodes, so create a copy
	// so that re-evaluating this cell produces the same result.
	const links = data.links.map(d => ({...d}));
	const nodes = data.nodes.map(d => ({...d}));

	// Create a simulation with several forces.
	const simulation = d3.forceSimulation(nodes)
		.force("link", d3.forceLink(links).id(d => d.id).distance(300))
	    .force("charge", d3.forceManyBody().strength(-10000))
	    .force("center", d3.forceCenter(width / 2, height / 2))
		.velocityDecay(0.2)
	    .on("tick", ticked);


	const zoom = d3.zoom().on("zoom", handleZoom);

	// Create the SVG container.
	const svg = d3.select("#chart")
	    .attr("viewBox", [0, 0, width, height])
		.call(zoom);

	svg.append("defs").append("marker")
      	.attr("id", "arrow")
       	.attr("viewBox", "0 -5 10 10")
        .attr("refX", 15)
        .attr("refY", 0)
        .attr("markerWidth", 4)
        .attr("markerHeight", 4)
        .attr("orient", "auto")
        .append("path")
        .attr("fill", "oklch(var(--n))")
        .attr("d", "M0,-5L10,0L0,5");

	const link = svg.append("g")
		.attr("id", "links")
    	.attr("fill", "none")
     	.attr("stroke-width", 4)
		.attr("opacity", 0.2)
      	.selectAll("path")
       	.data(links)
        .join("path")
        .attr("stroke", "oklch(var(--n))")
        .attr("marker-mid", d => `url(${new URL(`#arrow`, location)})`);

  	const node = svg.append("g")
		.attr("id", "nodes")
   		.attr("stroke", "oklch(var(--b2))")
     	.attr("stroke-width", 4)
       	.selectAll("g")
        .data(nodes)
        .join("g");

	node.append("circle")
		.attr("class", "cursor-pointer")
        .attr("r", circleRadius)
        .attr("fill", d => {
        	if (d.group == 1) {
         		return "oklch(var(--p))";
         	} else {
          		return "oklch(var(--a))";
          	}
        })
        .on("mouseover", revealTooltip)
        .on("mousemove", revealTooltip)
        .on("mouseleave", hideTooltip);
	
	node.append("text")
      	.attr("x", 16)
      	.attr("y", "0.31em")
	  	.attr("stroke-width", 0)
	  	.attr("class", "text-lg font-normal")
      	.text(d => d.id)
    	.clone(true).lower()
      	.attr("fill", "none")
      	.attr("stroke", "oklch(var(--b2))")
      	.attr("stroke-width", 4);

    d3.select("#tooltip").on("mouseout", function() {
    	d3.select('#tooltip').classed("hidden", true);
    });

    function revealTooltip(e, d) {
		d3.select(this).attr("r", circleRadiusHover);
     	d3.select('#tooltip')
         	.style("left", (e.pageX + 10) + "px")
          	.style("top", (e.pageY + 10) + "px")
            .classed("hidden", false);

		htmx.trigger("#tooltip", "fetch-content", { node: d.id });
    };

    function hideTooltip(e, d) {
    	if (e.toElement.id != "tooltip") {
			d3.select(this).attr("r", circleRadius);
     		d3.select('#tooltip').classed("hidden", true);
       	}
    };

    function linkArc(d) {
      const r = 0;
      const midX = (d.source.x + d.target.x) / 2;
      const midY = (d.source.y + d.target.y) / 2;
	  var node1 = d.source;
	  var node2 = d.target;
	  if (!isSources) {
		node1 = d.target;
		node2 = d.source;
	  }
      return `
      	M${node1.x},${node1.y}
        A${r},${r} 0 0,1 ${midX},${midY}
        A${r},${r} 0 0,1 ${node2.x},${node2.y}
      `;
    }

    // Set the position attributes of links and nodes each time the simulation ticks.
    function ticked() {
    	link.attr("d", linkArc);
        node.attr("transform", d => {
			return `translate(${d.x},${d.y})`
		});
    };

    function handleZoom(e) {
    	svg.select("#nodes")
     		.attr("transform", d => {
				return e.transform;
			});
    	svg.select("#links")
     		.attr("transform", d => {
				return e.transform;
			});
    }
}
