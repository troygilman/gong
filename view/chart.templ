package view

import (
	"gong/view/chart"
	"gong/types"
)

templ ActorSourcesChart1(data []chart.TreeDataNode) {
	<div
		class="w-full h-full"
	>
		@chart.Chart(chart.ChartProps{
			ID:     "actor-sources",
			Width:  "100%",
			Height: "100%",
		}) {
			@initActorSourcesChart("actor-sources", formatProjectUrl(ctx), data)
		}
	</div>
}

script initActorSourcesChart(chartID string, projectUrl string, data []chart.TreeDataNode) {
    Alpine.store("chart", {
        tooltipCache: {},
    });

	function tooltipHandler(params, ticket, callback) {
		let cache = Alpine.store("chart").tooltipCache;
		if (cache[params.name]) {
			return cache[params.name];
		}

		let handler = function(target, request) {
			let html = request.xhr.responseText;
			cache[params.name] = html
			callback(ticket, html);
		};

		htmx.ajax("GET", projectUrl + "/tooltip", {handler: handler});
		return "...";
	}

	options = {
      tooltip: {
        trigger: 'item',
        triggerOn: 'mousemove',
        formatter: tooltipHandler,
        enterable: true,
      },
      series: [
        {
          type: 'tree',
          data: data,
          top: '1%',
          left: 150,
          bottom: '1%',
          right: 150,
          //symbol: "arrow",
          //symbolRotate: -90,
          symbolSize: 7,
          orient: 'RL',
          label: {
            position: 'right',
            verticalAlign: 'middle',
            align: 'left',
            color: "white",
            width: 130,
            overflow: "truncate",
          },
          leaves: {
            label: {
              position: 'left',
              verticalAlign: 'middle',
              align: 'right',
              color: "white",
              width: 130,
              overflow: "truncate",
              backgroundColor: "oklch(var(--b1))",
            }
          },
          emphasis: {
            focus: 'descendant'
          },
          expandAndCollapse: false,
          animationDuration: 500,
          animationDurationUpdate: 500
        }
      ]
    };

    initChart(chartID, options);
}

templ ChartTooltip() {
	<div>
		Actor!!!
	</div>
}

templ ActorSourcesChart(sources []string) {
	<div class="w-full aspect-square border border-color rounded">
		<div>
			if flow, ok := ctx.Value(types.CtxFlow).(string); ok {
				@actorFlowChartFilter(flow)
			} else {
				@actorFlowChartFilter("sources")
			}
		</div>
		<svg id="chart" class="grow min-w-0 min-h-0 border-t border-color"></svg>
		<div id="tooltip" class="absolute hidden bg-base-300 border rounded"></div>
		@initActorChart(sources)
	</div>
}

templ actorFlowChartFilter(flow string) {
	<div role="tablist" class="tabs tabs-boxed">
		<input id="flow" type="hidden" name="flow" value={ flow }/>
		<a role="tab" class={ "tab", templ.KV("tab-active", flow == "sources") }>Sources</a>
		<a role="tab" class={ "tab", templ.KV("tab-active", flow == "sinks") }>Sinks</a>
	</div>
}

script initActorChart(sources []string) {
	const width = 200;
	const height = 200;

	let data = {
		"nodes": [
			{"id": "Head", "group": 1},
		],
		"links": [],
	}

	for (let i = 0; i < sources.length; i++) {
		let source = sources[i];
		data.nodes.push({"id": source, "group": 2});
		data.links.push({"source": source, "target": "Head", "value": 1});
	};

	// Specify the color scale.
	const color = d3.scaleOrdinal(d3.schemeCategory10);

	// The force simulation mutates links and nodes, so create a copy
	// so that re-evaluating this cell produces the same result.
	const links = data.links.map(d => ({...d}));
	const nodes = data.nodes.map(d => ({...d}));

	// Create a simulation with several forces.
	const simulation = d3.forceSimulation(nodes)
		.force("link", d3.forceLink(links).id(d => d.id))
	    .force("charge", d3.forceManyBody().strength(-1000))
	    .force("center", d3.forceCenter(width / 2, height / 2))
		.alphaDecay(0.1)
	    .on("tick", ticked);


	const zoom = d3.zoom().on("zoom", handleZoom);

	// Create the SVG container.
	const svg = d3.select("#chart")
	    .attr("viewBox", [0, 0, width, height])
		.call(zoom);

	svg.append("defs").append("marker")
      	.attr("id", "arrow")
       	.attr("viewBox", "0 -5 10 10")
        .attr("refX", 15)
        .attr("refY", 0)
        .attr("markerWidth", 6)
        .attr("markerHeight", 6)
        .attr("orient", "auto")
        .append("path")
        .attr("fill", "oklch(var(--n))")
        .attr("d", "M0,-5L10,0L0,5");

	const link = svg.append("g")
    	.attr("fill", "none")
     	.attr("stroke-width", 0.5)
      	.selectAll("path")
       	.data(links)
        .join("path")
        .attr("stroke", "oklch(var(--n))")
        .attr("marker-mid", d => `url(${new URL(`#arrow`, location)})`);

  	const node = svg.append("g")
   		.attr("stroke", "oklch(var(--b1))")
     	.attr("stroke-width", 1)
       	.selectAll()
        .data(nodes)
        .join("circle")
        .attr("r", 4)
        .attr("fill", d => {
        	if (d.group == 1) {
         		return "oklch(var(--p))";
         	} else {
          		return "oklch(var(--in))";
          	}
        })
        .on("mouseover", revealTooltip)
        .on("mousemove", revealTooltip)
        .on("mouseleave", hideTooltip);

    node.append("title").text(d => d.id);

    d3.select("#tooltip").on("mouseout", function() {
    	d3.select('#tooltip').classed("hidden", true);
    });

    function revealTooltip(e, d) {
     	d3.select('#tooltip')
         	.style("left", (e.pageX + 10) + "px")
          	.style("top", (e.pageY + 10) + "px")
           	.html(d.id)
            .classed("hidden", false);
    };

    function hideTooltip(e, d) {
    	if (e.toElement.id != "tooltip") {
     		d3.select('#tooltip').classed("hidden", true);
       	}
    };

    function linkArc(d) {
      const r = 0;
      const midX = (d.source.x + d.target.x) / 2;
      const midY = (d.source.y + d.target.y) / 2;
      return `
      	M${d.source.x},${d.source.y}
        A${r},${r} 0 0,1 ${midX},${midY}
        A${r},${r} 0 0,1 ${d.target.x},${d.target.y}
      `;
    }

    // Set the position attributes of links and nodes each time the simulation ticks.
    function ticked() {
    	link
        	.attr("d", linkArc);

        node
        	.attr("cx", d => d.x)
         	.attr("cy", d => d.y);
    };

    function handleZoom(e) {
    	svg.selectAll("svg g")
     		.attr('transform', e.transform);
    }
}
