package view

import (
	"gong/view/chart"
)

templ ActorSourcesChart1(data []chart.TreeDataNode) {
	<div
		class="w-full h-full"
	>
		@chart.Chart(chart.ChartProps{
			ID:     "actor-sources",
			Width:  "100%",
			Height: "100%",
		}) {
			@initActorSourcesChart("actor-sources", formatProjectUrl(ctx), data)
		}
	</div>
}

script initActorSourcesChart(chartID string, projectUrl string, data []chart.TreeDataNode) {
    Alpine.store("chart", {
        tooltipCache: {},
    });

	function tooltipHandler(params, ticket, callback) {
		let cache = Alpine.store("chart").tooltipCache;
		if (cache[params.name]) {
			return cache[params.name];
		}

		let handler = function(target, request) {
			let html = request.xhr.responseText;
			cache[params.name] = html
			callback(ticket, html);
		};

		htmx.ajax("GET", projectUrl + "/tooltip", {handler: handler});
		return "...";
	}

	options = {
      tooltip: {
        trigger: 'item',
        triggerOn: 'mousemove',
        formatter: tooltipHandler,
        enterable: true,
      },
      series: [
        {
          type: 'tree',
          data: data,
          top: '1%',
          left: 150,
          bottom: '1%',
          right: 150,
          //symbol: "arrow",
          //symbolRotate: -90,
          symbolSize: 7,
          orient: 'RL',
          label: {
            position: 'right',
            verticalAlign: 'middle',
            align: 'left',
            color: "white",
            width: 130,
            overflow: "truncate",
          },
          leaves: {
            label: {
              position: 'left',
              verticalAlign: 'middle',
              align: 'right',
              color: "white",
              width: 130,
              overflow: "truncate",
              backgroundColor: "oklch(var(--b1))",
            }
          },
          emphasis: {
            focus: 'descendant'
          },
          expandAndCollapse: false,
          animationDuration: 500,
          animationDurationUpdate: 500
        }
      ]
    };

    initChart(chartID, options);
}

templ ChartTooltip() {
	<div>
		Actor!!!
	</div>
}

templ ActorSourcesChart(data []chart.TreeDataNode) {
	<div class="grow min-w-0 min-h-0">
		<svg id="chart" class="w-full h-full"></svg>
		@initActorChart()
	</div>
}

script initActorChart() {
	const width = 200;
	const height = 200;

	const sources = [
		{"pid": "Source1"},
		{"pid": "Source2"},
		{"pid": "Source3"},
		{"pid": "Source4"},
		{"pid": "Source5"},
		{"pid": "Source6"},
		{"pid": "Source7"},
		{"pid": "Source8"},
		{"pid": "Source9"},
		{"pid": "Source11"},
		{"pid": "Source12"},
		{"pid": "Source13"},
		{"pid": "Source14"},
		{"pid": "Source15"},
		{"pid": "Source16"},
		{"pid": "Source17"},
		{"pid": "Source18"},
		{"pid": "Source19"},
	];

	let data = {
		"nodes": [
			{"id": "Head", "group": 1, "fx": width * 0.9, "fy": height / 2.0},
		],
		"links": [],
	}

	const sourcesInterval = (height * 0.8) / (sources.length - 1);
	for (let i = 0; i < sources.length; i++) {
		let source = sources[i];
		data.nodes.push({"id": source.pid, "group": 2, "fx": width * 0.1, "fy": (height * 0.1) + (sourcesInterval * i)});
		data.links.push({"source": source.pid, "target": "Head", "value": 1});
	};

	// Specify the color scale.
	const color = d3.scaleOrdinal(d3.schemeCategory10);

	// The force simulation mutates links and nodes, so create a copy
	// so that re-evaluating this cell produces the same result.
	const links = data.links.map(d => ({...d}));
	const nodes = data.nodes.map(d => ({...d}));

	// Create a simulation with several forces.
	const simulation = d3.forceSimulation(nodes)
		.force("link", d3.forceLink(links).id(d => d.id))
	    .force("charge", d3.forceManyBody().strength(-1000))
	    .force("center", d3.forceCenter(width / 2, height / 2))
		.alphaDecay(0.1)
	    .on("tick", ticked);


	const zoom = d3.zoom().on("zoom", handleZoom);

	// Create the SVG container.
	const svg = d3.select("#chart")
	    .attr("viewBox", [0, 0, width, height])
		.call(zoom);

	const link = svg.append("g")
    	.attr("fill", "none")
     	.attr("stroke-width", 1)
      	.selectAll("path")
       	.data(links)
        .join("path")
        .attr("stroke", "#999");
        //.attr("marker-end", d => `url(${new URL(`#arrow-${d.type}`, location)})`);

  	const node = svg.append("g")
    	.attr("stroke", "#fff")
      	.attr("stroke-width", 1.5)
       	.selectAll()
        .data(nodes)
        .join("circle")
        .attr("r", 3)
        .attr("fill", d => color(d.group));

    node.append("title").text(d => d.id);

    function linkArc(d) {
      const r = 0;
      return `
        M${d.source.x},${d.source.y}
        A${r},${r} 0 0,1 ${d.target.x},${d.target.y}
      `;
    }

    // Set the position attributes of links and nodes each time the simulation ticks.
    function ticked() {
    	link
        	.attr("d", linkArc);

        node
        	.attr("cx", d => d.x)
         	.attr("cy", d => d.y);
    };

    function handleZoom(e) {
    	svg.selectAll("svg g")
     		.attr('transform', e.transform);
    }
}
