package view

import (
	"gong/view/chart"
)

templ ActorSourcesChart(data []chart.TreeDataNode) {
	<div
		class="w-full h-full"
	>
		@chart.Chart(chart.ChartProps{
			ID:     "actor-sources",
			Width:  "100%",
			Height: "100%",
		}) {
			@initActorSourcesChart("actor-sources", formatProjectUrl(ctx), data)
		}
	</div>
}

script initActorSourcesChart(chartID string, projectUrl string, data []chart.TreeDataNode) {
    Alpine.store("chart", {
        tooltipCache: {},
    });

	function tooltipHandler(params, ticket, callback) {
		let cache = Alpine.store("chart").tooltipCache;
		if (cache[params.name]) {
			return cache[params.name];
		}

		let handler = function(target, request) {
			let html = request.xhr.responseText;
			cache[params.name] = html
			callback(ticket, html);
		};

		htmx.ajax("GET", projectUrl + "/tooltip", {handler: handler});
		return "...";
	}

	options = {
      tooltip: {
        trigger: 'item',
        triggerOn: 'mousemove',
        formatter: tooltipHandler,
        enterable: true,
      },
      series: [
        {
          type: 'tree',
          data: data,
          top: '1%',
          left: 150,
          bottom: '1%',
          right: 150,
          symbol: "arrow",
          symbolRotate: -90,
          symbolSize: 7,
          orient: 'RL',
          label: {
            position: 'right',
            verticalAlign: 'middle',
            align: 'left',
            color: "white",
            width: 130,
            overflow: "truncate",
          },
          leaves: {
            label: {
              position: 'left',
              verticalAlign: 'middle',
              align: 'right',
            }
          },
          emphasis: {
            focus: 'descendant'
          },
          expandAndCollapse: false,
          animationDuration: 500,
          animationDurationUpdate: 500
        }
      ]
    };

    initChart(chartID, options);
}

templ ChartTooltip() {
	<div>
		Actor!!!
	</div>
}
