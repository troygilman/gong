package chart

type ChartProps struct {
	ID     string
	Width  string
	Height string
}

templ Chart(props ChartProps) {
	<div id="chart">
		<div class="container">
			<div class={ "item", item(props) } id={ props.ID }></div>
		</div>
		<script>
			function initChart(chartID, options) {
				"use strict";
				let elem = document.getElementById(chartID);
				let chart = echarts.init(elem);
				chart.setOption(options);

				document.defaultView.addEventListener("resize", (e) => {
					chart.resize();
				});
			}
		</script>
		{ children... }
	</div>
}

css item(props ChartProps) {
	width: { props.Width };
	height: { props.Height };
	max-width: { props.Width };
	max-height: { props.Height };
	min-width: { props.Width };
	min-height: { props.Height };
}

type TreeDataNode struct {
	Name      string         `json:"name"`
	Value     int            `json:"value"`
	Collapsed *bool          `json:"collapsed"`
	Children  []TreeDataNode `json:"children"`
}
