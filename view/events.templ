package view

import (
	"fmt"
	"gong/types"
	"strings"
)

templ eventsTabContent(props types.ProjectActorProps) {
	if filter, ok := ctx.Value(types.CtxFilter).(types.EventsFilter); ok {
		@eventsFilter(filter)
	} else {
		@eventsFilter(types.EventsFilter{})
	}
	@ProjectActorEventsContainer(props)
}

templ ProjectActorEventsContainer(props types.ProjectActorProps) {
	<div
		id="events-container"
		class="grow min-h-0 max-w-full overflow-x-auto"
		x-data="{ scrollTop: 0 }"
		@scroll={ fmt.Sprintf("$data.scrollTop = handleScroll('%s', $data)", formatActorPIDCtx(ctx)) }
		@htmx:after-request="onAfterRequest($event)"
	>
		<script>
			function handleScroll(pid, { scrollTop }) {
				const container = document.getElementById("events-container");
				if (container.scrollTop < scrollTop) {
					if (loadNext(container)) {
						htmx.trigger('#events-top-data-loader', 'load-next', {})
					}
				} else if (container.scrollTop > scrollTop) {
					if (loadPrev(container)) {
						htmx.trigger('#events-bottom-data-loader', 'load-prev', {})
					}
				}
				return container.scrollTop;
			}

			function loadNext(container) {
				return container.scrollTop <= container.scrollHeight * 0.1;
			}

			function loadPrev(container) {
				return container.scrollTop + container.offsetHeight >= container.scrollHeight * 0.9;
			}

			function onAfterRequest(e) {
				const maxEvents = 100;
				const container = document.getElementById("events-container");
				const events = container.querySelectorAll(".event");
				const overflow = events.length - maxEvents;
				if (e.detail.target.id === "events-top-data-loader") {
					if (overflow > 0) {
						for (let i = maxEvents; i < events.length; i++) {
							htmx.remove(events[i]);
						}
					}
					console.log("event swap top - overflow:", overflow)
				} else if (e.detail.target.id === "events-bottom-data-loader") {
					if (overflow > 0) {
						for (let i = 0; i < overflow; i++) {
							htmx.remove(events[i]);
						}
					}
					console.log("event swap bottom - overflow:", overflow)
				}
			}
		</script>
		<table id="events-table" class="table table-pin-rows table-sm">
			<thead>
				<tr>
					<th>Timestamp</th>
					<th>ID</th>
					<th>Type</th>
					<th>Sender</th>
					<th>Level</th>
					<th>Message</th>
				</tr>
			</thead>
			<tbody
				id="events-container"
				hx-sync="this"
			>
				@eventsTopDataLoader(false, false)
				@eventsBottomDataLoader(false, true)
			</tbody>
		</table>
	</div>
}

templ eventsFilter(filter types.EventsFilter) {
	<form
		id="events-filter"
		class="join border rounded-lg m-4 w-fit"
		hx-get={ formatProjectUrl(ctx, "/actor") }
		hx-include={ includes }
		hx-trigger="submit"
		hx-swap="none"
		hx-push-url="true"
	>
		<script>
			function updateFilter() {
				const form = document.getElementById('events-filter');
				for (const input of form.elements) {
					if (input.value !== input.defaultValue) {
						htmx.trigger('#events-filter', 'submit', {});
					}
				}
			}
		</script>
		@eventsFilterItem("Type", "filter_type", filter.Type != nil) {
			<input
				name="filter_type"
				type="text"
				placeholder="actor.Started"
				if filter.Type != nil {
					value={ *filter.Type }
				}
				class="input input-bordered input-sm w-full max-w-xs focus:outline-none"
				@keydown.enter="updateFilter()"
				@focusout="updateFilter()"
			/>
		}
		<div class="h-full border w-0"></div>
		@eventsFilterItem("Sender", "filter_sender", filter.Sender != nil) {
			<input
				name="filter_sender"
				type="text"
				placeholder="actor.Started"
				if filter.Sender != nil {
					value={ *filter.Sender }
				}
				class="input input-bordered input-sm w-full max-w-xs focus:outline-none"
				@keydown.enter="updateFilter()"
				@focusout="updateFilter()"
			/>
		}
	</form>
}

templ eventsFilterItem(label string, name string, active bool) {
	<div class="join-item indicator">
		if active {
			<span
				class="indicator-item badge badge-primary badge-sm cursor-pointer pl-0 pr-0"
				hx-get={ formatProjectUrl(ctx, "/actor") }
				hx-include={ includes }
				hx-params={ "not " + name }
				hx-trigger="click"
				hx-swap="none"
				hx-push-url="true"
			>
				@closeIcon("inline-block w-4 h-4 stroke-current")
			</span>
		}
		<div class="dropdown">
			<div tabindex="0" role="button" class="btn btn-ghost btn-sm no-animation rounded-none">{ label }</div>
			<div tabindex="0" class="dropdown-content z-50 shadow bg-base-100 rounded-box w-64">
				{ children... }
			</div>
		</div>
	</div>
}

templ eventsTopDataLoader(oob bool, moreEvents bool) {
	<tr
		id="events-top-data-loader"
		hx-get={ formatProjectUrl(ctx, "/events") }
		hx-vals={ fmt.Sprintf(`js:{ "id": topID(), "n": %d }`, 10) }
		hx-include={ includes }
		hx-swap="outerHTML"
		if moreEvents {
			hx-trigger="every 1s [load()], load-next once, intersect once delay:10ms"
		} else {
			hx-trigger="every 1s [load()]"
		}
		if oob {
			hx-swap-oob="true"
		}
	>
		<script>
			function load() {
				const container = document.getElementById("events-container");
				return loadNext(container);
			}
			function topID() {
				const events = document.getElementById("events-container").querySelectorAll(".event");
				if (events.length > 0) {
					return events[0].querySelector("input").value;
				} else {
					return "";
				}
			}
		</script>
	</tr>
}

templ eventsBottomDataLoader(oob bool, moreEvents bool) {
	<tr
		id="events-bottom-data-loader"
		if moreEvents {
			hx-get={ formatProjectUrl(ctx, "/events") }
			hx-vals={ fmt.Sprintf(`js:{ "id": bottomID(), "n": %d }`, -10) }
			hx-include={ includes }
			hx-swap="outerHTML"
			hx-trigger="load-prev once, intersect once"
		}
		if oob {
			hx-swap-oob="true"
		}
	>
		<script>
			function bottomID() {
				const events = document.getElementById("events-container").querySelectorAll(".event");
				if (events.length > 0) {
					return events[events.length-1].querySelector("input").value;
				} else {
					return "";
				}
			}
		</script>
	</tr>
}

func formatActorPIDCtx(ctx context.Context) string {
	if pid, ok := ctx.Value(types.CtxPID).(string); ok {
		return formatActorPID(pid)
	}
	return ""
}

func formatActorPID(pid string) string {
	return strings.ReplaceAll(pid, "/", "-")
}

templ ProjectActorEvents(events types.EventList, appendTop bool, moreTop bool, moreBottom bool) {
	if appendTop || (!appendTop && moreBottom) {
		@eventsTopDataLoader(!appendTop, moreTop)
	}
	for i := 0; i < len(events); i++ {
		@projectActorEvent(events[i])
	}
	if !appendTop || (appendTop && moreTop) {
		@eventsBottomDataLoader(appendTop, moreBottom)
	}
}

templ projectActorEvent(event types.Event) {
	<tr id={ fmt.Sprintf("event-%d", event.Index) } class="event">
		<input type="hidden" value={ event.ID.String() }/>
		<td>
			{ event.Timestamp.String() }
		</td>
		<td>
			{ event.ID.String() }
		</td>
		<td>
			{ event.Type }
		</td>
		<td>
			{ event.Event.Sender }
		</td>
		<td>
			{ event.Level.String() }
		</td>
		<td>
			{ event.Msg }
		</td>
	</tr>
}

templ projectActorEventDelete(index int32) {
	<tr id={ fmt.Sprintf("event-%d", index) } hx-swap-oob="delete"></tr>
}
