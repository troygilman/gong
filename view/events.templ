package view

import (
	"fmt"
	gong_common "gong/common"
	"gong/view/common"
	"strings"
	"log/slog"
	"strconv"
)

templ eventsTabContent(actor gong_common.Actor) {
	if filter, ok := ctx.Value(gong_common.CtxFilter).(gong_common.Filter); ok {
		@eventsFilter(filter)
	} else {
		@eventsFilter(gong_common.Filter{})
	}
	@ProjectActorEventsContainer(actor)
}

templ ProjectActorEventsContainer(actor gong_common.Actor) {
	<div
		id="events-container"
		class="grow min-h-0 max-w-full overflow-x-auto relative"
		hx-ext="sse"
		sse-connect={ common.FormatProjectUrl(ctx) + "/sse/events" }
		hx-include={ common.Includes }
		x-data="{ scrollTop: 0 }"
		@scroll={ fmt.Sprintf("$data.scrollTop = handleScroll('%s', $data)", formatActorPIDCtx(ctx)) }
		@htmx:after-request="onAfterRequest($event)"
	>
		<script>
			function handleScroll(pid, { scrollTop }) {
				const container = document.getElementById("events-container");
				try {
					if (container.scrollTop < scrollTop) {
						if (shouldLoadTop()) {
							htmx.trigger('#events-top-data-loader', 'load-next', {})
						}
					} else if (container.scrollTop > scrollTop) {
						if (shouldLoadBottom()) {
							htmx.trigger('#events-bottom-data-loader', 'load-prev', {})
						}
					}
				} catch (error) {
					console.log(error);
				}
				return container.scrollTop;
			}

			function shouldLoadTop() {
				console.log("shouldLoadTop");
				const container = document.getElementById("events-container");
				return container.scrollTop <= container.scrollHeight * 0.1;
			}

			function shouldLoadBottom() {
				const container = document.getElementById("events-container");
				return container.scrollTop + container.offsetHeight >= container.scrollHeight * 0.9;
			}

			function getTopID() {
				const events = document.getElementById("events-container").querySelectorAll(".event");
				if (events.length > 0) {
					return events[0].querySelector("input").value;
				} else {
					return "";
				}
			}

			function getBottomID() {
				const events = document.getElementById("events-container").querySelectorAll(".event");
				if (events.length > 0) {
					return events[events.length-1].querySelector("input").value;
				} else {
					return "";
				}
			}

			function onAfterRequest(e) {
				const maxEvents = 200;
				const container = document.getElementById("events-container");
				const events = container.querySelectorAll(".event");
				const overflow = events.length - maxEvents;
				if (e.detail.target.id === "events-top-data-loader") {
					if (overflow > 0) {
						for (let i = maxEvents; i < events.length; i++) {
							htmx.remove(events[i]);
						}
					}
					console.log("event swap top - overflow:", overflow)
				} else if (e.detail.target.id === "events-bottom-data-loader") {
					if (overflow > 0) {
						for (let i = 0; i < overflow; i++) {
							htmx.remove(events[i]);
						}
					}
					console.log("event swap bottom - overflow:", overflow)
				}
			}

			htmx.on("htmx:beforeRequest", function(e) {
				if (e.srcElement.id == "events-top-data-loader" && !shouldLoadTop()) {
					e.preventDefault();
				}
			});
		</script>
		<table id="events-table" class="table table-pin-rows table-sm">
			<thead>
				<tr class="cursor-default">
					<th>Timestamp</th>
					<th>Type</th>
					<th>Sender</th>
					<th>Level</th>
					<th>Message</th>
				</tr>
			</thead>
			<tbody
				id="events-container"
				hx-sync="this"
			>
				@eventsTopDataLoader(false, false)
				@eventsBottomDataLoader(false, true, true)
			</tbody>
		</table>
		<div id="spinner" class="spinner absolute top-0 w-full h-full items-center justify-center">
			<span class="loading loading-dots loading-lg"></span>
		</div>
	</div>
}

templ eventsFilter(filter gong_common.Filter) {
	<form
		id="events-filter"
		class="join m-4 w-fit"
		hx-get={ common.FormatProjectUrl(ctx) }
		hx-include={ common.Includes }
		hx-headers={ `{"View": "actor"}` }
		hx-trigger="submit"
		hx-swap="none"
		hx-push-url="true"
	>
		<script>
			function updateFilter() {
				console.log("updateFilter()");
				const inputs = document.getElementById('events-filter').querySelectorAll("input");
				for (const input of inputs) {
					if (input.value !== input.defaultValue || input.checked !== input.defaultChecked) {
						htmx.trigger('#events-filter', 'submit', {});
					}
				}
			}
		</script>
		@eventsFilterItem("Type", gong_common.ParamFilterType, filter.Type != nil, -1) {
			<input
				class="event-filter-input"
				name={ gong_common.ParamFilterType }
				type="text"
				placeholder="actor.Started"
				if filter.Type != nil {
					value={ *filter.Type }
				}
			/>
		}
		@eventsFilterItem("Sender", gong_common.ParamFilterSender, filter.Sender != nil, 0) {
			<input
				class="event-filter-input"
				name={ gong_common.ParamFilterSender }
				type="text"
				placeholder="local/server/primary"
				if filter.Sender != nil {
					value={ *filter.Sender }
				}
			/>
		}
		@eventsFilterItem("Level", gong_common.ParamFilterLevel, filter.Level != nil, 1) {
			<div class="px-2 py-1">
				@eventsFilterLevelOption("DEBUG", slog.LevelDebug, filter.Level)
				@eventsFilterLevelOption("INFO", slog.LevelInfo, filter.Level)
				@eventsFilterLevelOption("WARN", slog.LevelWarn, filter.Level)
				@eventsFilterLevelOption("ERROR", slog.LevelError, filter.Level)
			</div>
		}
	</form>
}

templ eventsFilterLevelOption(label string, level slog.Level, selected *slog.Level) {
	<div class="form-control">
		<label class="label cursor-pointer py-1">
			<span class="label-text">{ label }</span>
			<input
				type="radio"
				name={ gong_common.ParamFilterLevel }
				class="radio"
				value={ strconv.Itoa(int(level)) }
				if selected != nil && *selected == level {
					checked
				}
			/>
		</label>
	</div>
}

templ eventsFilterItem(label string, name string, active bool, placement int) {
	<div class="join-item indicator">
		if active {
			<span
				class="indicator-item badge badge-info badge-sm cursor-pointer pl-0 pr-0"
				hx-get={ common.FormatProjectUrl(ctx) }
				hx-include={ common.Includes }
				hx-params={ "not " + name }
				hx-headers={ `{"View": "actor"}` }
				hx-trigger="click"
				hx-swap="none"
				hx-push-url="true"
			>
				@common.CloseIcon("inline-block w-4 h-4 stroke-current")
			</span>
		}
		<div class="dropdown group">
			<div
				tabindex="0"
				role="button"
				class={ "event-filter-button-container", templ.KV("rounded-l-lg", placement < 0), templ.KV("rounded-r-lg", placement > 0) }
			>
				<div class={ "event-filter-button", templ.KV("bg-neutral text-neutral-content", active) }>{ label }</div>
			</div>
			<div
				tabindex="0"
				class="dropdown-content z-50 shadow bg-base-100 rounded-lg rounded-tl-none w-64 border"
				@focusout="if (!$el.contains($event.relatedTarget)) { updateFilter() }"
				@keydown.enter="updateFilter()"
			>
				{ children... }
			</div>
		</div>
	</div>
}

templ eventsTopDataLoader(oob bool, moreEvents bool) {
	<tr
		id="events-top-data-loader"
		hx-get={ common.FormatProjectUrl(ctx) + "/events" }
		hx-vals={ fmt.Sprintf(`js:{ "timestamp": getTopID(), "n": %d }`, 20) }
		hx-include={ common.Includes }
		hx-swap="outerHTML"
		if moreEvents {
			hx-trigger="sse:new-events, load-next once, intersect once delay:100ms"
		} else {
			hx-trigger="sse:new-events"
		}
		if oob {
			hx-swap-oob="true"
		}
	></tr>
}

templ eventsBottomDataLoader(oob bool, moreEvents bool, spinner bool) {
	<tr
		id="events-bottom-data-loader"
		if moreEvents {
			hx-get={ common.FormatProjectUrl(ctx) + "/events" }
			hx-vals={ fmt.Sprintf(`js:{ "timestamp": getBottomID(), "n": %d }`, -20) }
			hx-include={ common.Includes }
			hx-swap="outerHTML"
			hx-trigger="load-prev once, intersect once"
			if spinner {
				hx-indicator="#spinner"
			}
		}
		if oob {
			hx-swap-oob="true"
		}
	></tr>
}

func formatActorPIDCtx(ctx context.Context) string {
	if pid, ok := ctx.Value(gong_common.CtxPID).(string); ok {
		return formatActorPID(pid)
	}
	return ""
}

func formatActorPID(pid string) string {
	return strings.ReplaceAll(pid, "/", "-")
}

templ ProjectActorEvents(events gong_common.EventList, appendTop bool, moreTop bool, moreBottom bool) {
	if appendTop || (!appendTop && moreBottom) {
		@eventsTopDataLoader(!appendTop, moreTop)
	}
	for i := 0; i < len(events); i++ {
		@projectActorEvent(events[i])
	}
	if !appendTop || (appendTop && moreTop) {
		@eventsBottomDataLoader(appendTop, moreBottom, false)
	}
}

templ projectActorEvent(event gong_common.Event) {
	<tr id={ fmt.Sprintf("event-%s", strconv.Itoa(int(event.Timestamp.UnixNano()))) } class="event">
		<input type="hidden" value={ strconv.Itoa(int(event.Timestamp.UnixNano())) }/>
		<td>
			{ event.Timestamp.String() }
		</td>
		<td>
			{ event.Type }
		</td>
		<td>
			if event.Sender != "" {
				{ event.Sender }
			} else {
				N/A
			}
		</td>
		<td>
			{ event.Level.String() }
		</td>
		<td>
			if event.Msg != "" {
				{ event.Msg }
			} else {
				N/A
			}
		</td>
	</tr>
}
