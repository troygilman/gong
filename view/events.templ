package view

import (
	"fmt"
	"gong/types"
	"strings"
	"log/slog"
	"strconv"
)

templ eventsTabContent(props types.ProjectActorProps) {
	if filter, ok := ctx.Value(types.CtxFilter).(types.EventsFilter); ok {
		@eventsFilter(filter)
	} else {
		@eventsFilter(types.EventsFilter{})
	}
	@ProjectActorEventsContainer(props)
}

templ ProjectActorEventsContainer(props types.ProjectActorProps) {
	<div
		id="events-container"
		class="grow min-h-0 max-w-full overflow-x-auto"
		x-data="{ scrollTop: 0 }"
		@scroll={ fmt.Sprintf("$data.scrollTop = handleScroll('%s', $data)", formatActorPIDCtx(ctx)) }
		@htmx:after-request="onAfterRequest($event)"
	>
		<script>
			function handleScroll(pid, { scrollTop }) {
				const container = document.getElementById("events-container");
				try {
					if (container.scrollTop < scrollTop) {
						if (shouldLoadTop()) {
							htmx.trigger('#events-top-data-loader', 'load-next', {})
						}
					} else if (container.scrollTop > scrollTop) {
						if (shouldLoadBottom()) {
							htmx.trigger('#events-bottom-data-loader', 'load-prev', {})
						}
					}
				} catch (error) {
					console.log(error);
				}
				return container.scrollTop;
			}

			function shouldLoadTop() {
				const container = document.getElementById("events-container");
				return container.scrollTop <= container.scrollHeight * 0.1;
			}

			function shouldLoadBottom() {
				const container = document.getElementById("events-container");
				return container.scrollTop + container.offsetHeight >= container.scrollHeight * 0.9;
			}

			function getTopID() {
				const events = document.getElementById("events-container").querySelectorAll(".event");
				if (events.length > 0) {
					return events[0].querySelector("input").value;
				} else {
					return "";
				}
			}

			function getBottomID() {
				const events = document.getElementById("events-container").querySelectorAll(".event");
				if (events.length > 0) {
					return events[events.length-1].querySelector("input").value;
				} else {
					return "";
				}
			}

			function onAfterRequest(e) {
				const maxEvents = 200;
				const container = document.getElementById("events-container");
				const events = container.querySelectorAll(".event");
				const overflow = events.length - maxEvents;
				if (e.detail.target.id === "events-top-data-loader") {
					if (overflow > 0) {
						for (let i = maxEvents; i < events.length; i++) {
							htmx.remove(events[i]);
						}
					}
					console.log("event swap top - overflow:", overflow)
				} else if (e.detail.target.id === "events-bottom-data-loader") {
					if (overflow > 0) {
						for (let i = 0; i < overflow; i++) {
							htmx.remove(events[i]);
						}
					}
					console.log("event swap bottom - overflow:", overflow)
				}
			}
		</script>
		<table id="events-table" class="table table-pin-rows table-sm">
			<thead>
				<tr>
					<th>Timestamp</th>
					<th>ID</th>
					<th>Type</th>
					<th>Sender</th>
					<th>Level</th>
					<th>Message</th>
				</tr>
			</thead>
			<tbody
				id="events-container"
				hx-sync="this"
			>
				@eventsTopDataLoader(false, false)
				@eventsBottomDataLoader(false, true)
			</tbody>
		</table>
	</div>
}

templ eventsFilter(filter types.EventsFilter) {
	<form
		id="events-filter"
		class="join m-4 w-fit"
		hx-get={ formatProjectUrl(ctx, "/actor") }
		hx-include={ includes }
		hx-trigger="submit"
		hx-swap="none"
		hx-push-url="true"
	>
		<script>
			function updateFilter() {
				console.log("updateFilter()");
				const inputs = document.getElementById('events-filter').querySelectorAll("input");
				for (const input of inputs) {
					if (input.value !== input.defaultValue || input.checked !== input.defaultChecked) {
						htmx.trigger('#events-filter', 'submit', {});
					}
				}
			}
		</script>
		@eventsFilterItem("ID", "filter_id", filter.ID != "", -1) {
			<input
				name="filter_id"
				type="text"
				placeholder="01HXZJN46DQJPWYBAM"
				value={ filter.ID }
				class="event-filter-input"
			/>
		}
		@eventsFilterItem("Type", "filter_type", filter.Type != "", 0) {
			<input
				name="filter_type"
				type="text"
				placeholder="actor.Started"
				value={ filter.Type }
				class="event-filter-input"
			/>
		}
		@eventsFilterItem("Sender", "filter_sender", filter.Sender != "", 0) {
			<input
				name="filter_sender"
				type="text"
				placeholder="local/server/primary"
				value={ filter.Sender }
				class="event-filter-input"
			/>
		}
		@eventsFilterItem("Level", "filter_level", filter.Level != slog.LevelDebug, 1) {
			<div class="px-2 py-1">
				@eventsFilterLevelOption("DEBUG", slog.LevelDebug, filter.Level)
				@eventsFilterLevelOption("INFO", slog.LevelInfo, filter.Level)
				@eventsFilterLevelOption("WARN", slog.LevelWarn, filter.Level)
				@eventsFilterLevelOption("ERROR", slog.LevelError, filter.Level)
			</div>
		}
	</form>
}

templ eventsFilterLevelOption(label string, level slog.Level, selected slog.Level) {
	<div class="form-control">
		<label class="label cursor-pointer py-1">
			<span class="label-text">{ label }</span>
			<input
				type="radio"
				name="filter_level"
				class="radio"
				value={ strconv.Itoa(int(level)) }
				if selected == level {
					checked
				}
			/>
		</label>
	</div>
}

templ eventsFilterItem(label string, name string, active bool, placement int) {
	<div class="join-item indicator">
		if active {
			<span
				class="indicator-item badge badge-primary badge-sm cursor-pointer pl-0 pr-0"
				hx-get={ formatProjectUrl(ctx, "/actor") }
				hx-include={ includes }
				hx-params={ "not " + name }
				hx-trigger="click"
				hx-swap="none"
				hx-push-url="true"
			>
				@closeIcon("inline-block w-4 h-4 stroke-current")
			</span>
		}
		<div class="dropdown group">
			<div
				tabindex="0"
				role="button"
				class={ "border overflow-hidden group-focus-within:rounded-b-none group-focus-within:border-b-0", templ.KV("rounded-l-lg", placement < 0), templ.KV("rounded-r-lg", placement > 0) }
			>
				<div class="event-filter-button">{ label }</div>
			</div>
			<div
				tabindex="0"
				class="dropdown-content z-50 shadow bg-base-100 rounded-lg rounded-tl-none w-64 border"
				@focusout="if (!$el.contains($event.relatedTarget)) { updateFilter() }"
				@keydown.enter="updateFilter()"
			>
				{ children... }
			</div>
		</div>
	</div>
}

templ eventsTopDataLoader(oob bool, moreEvents bool) {
	<tr
		id="events-top-data-loader"
		hx-get={ formatProjectUrl(ctx, "/events") }
		hx-vals={ fmt.Sprintf(`js:{ "id": getTopID(), "n": %d }`, 20) }
		hx-include={ includes }
		hx-swap="outerHTML"
		if moreEvents {
			hx-trigger="every 1s [shouldLoadTop()], load-next once, intersect once delay:20ms"
		} else {
			hx-trigger="every 1s [shouldLoadTop()]"
		}
		if oob {
			hx-swap-oob="true"
		}
	></tr>
}

templ eventsBottomDataLoader(oob bool, moreEvents bool) {
	<tr
		id="events-bottom-data-loader"
		if moreEvents {
			hx-get={ formatProjectUrl(ctx, "/events") }
			hx-vals={ fmt.Sprintf(`js:{ "id": getBottomID(), "n": %d }`, -20) }
			hx-include={ includes }
			hx-swap="outerHTML"
			hx-trigger="load-prev once, intersect once"
		}
		if oob {
			hx-swap-oob="true"
		}
	></tr>
}

func formatActorPIDCtx(ctx context.Context) string {
	if pid, ok := ctx.Value(types.CtxPID).(string); ok {
		return formatActorPID(pid)
	}
	return ""
}

func formatActorPID(pid string) string {
	return strings.ReplaceAll(pid, "/", "-")
}

templ ProjectActorEvents(events types.EventList, appendTop bool, moreTop bool, moreBottom bool) {
	if appendTop || (!appendTop && moreBottom) {
		@eventsTopDataLoader(!appendTop, moreTop)
	}
	for i := 0; i < len(events); i++ {
		@projectActorEvent(events[i])
	}
	if !appendTop || (appendTop && moreTop) {
		@eventsBottomDataLoader(appendTop, moreBottom)
	}
}

templ projectActorEvent(event types.Event) {
	<tr id={ fmt.Sprintf("event-%d", event.Index) } class="event">
		<input type="hidden" value={ event.ID.String() }/>
		<td>
			{ event.Timestamp.String() }
		</td>
		<td>
			{ event.ID.String() }
		</td>
		<td>
			{ event.Type }
		</td>
		<td>
			{ event.Event.Sender }
		</td>
		<td>
			{ event.Level.String() }
		</td>
		<td>
			{ event.Msg }
		</td>
	</tr>
}
