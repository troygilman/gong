package view

import (
	"gong/types"
)

templ overviewTabContent(actor types.Actor) {
	<div class="grid grid-cols-3 gap-4 p-4 w-full h-full max-h-full overflow-y-auto">
		<div hx-get={ formatProjectUrl(ctx) + "/chart" } hx-swap="outerHTML" hx-trigger="load" hx-include={ includes }></div>
		<div class="">Detail</div>
	</div>
}
