package view

import (
	"fmt"
	"github.com/google/uuid"
	"gong/types"
	"strings"
)

templ Project(props types.ProjectProps, actorIndex int) {
	@Index() {
		@initStore("", tabLabelEvents)
		<div
			class="flex flex-col h-screen w-screen max-h-screen max-w-screen"
			hx-ext="sse"
			sse-connect={ "/project/" + props.ID.String() + "/sse" }
			x-data
		>
			<div class="flex flex-row border-b border-neutral py-2 px-4 w-full items-center justify-center drop-shadow z-50">
				<div class="flex text-md font-bold items-center justify-center">
					Project
				</div>
				<div class="dropdown ml-2">
					<div tabindex="0" role="button" class="btn btn-ghost btn-sm no-animation">{ props.ID.String() }</div>
					<ul tabindex="0" class="dropdown-content z-50 menu p-1 shadow bg-base-100 rounded-box w-full">
						<li><a>Item 1</a></li>
						<li><a>Item 2</a></li>
					</ul>
				</div>
			</div>
			<div
				class="flex flex-row grow min-w-full min-h-0"
				x-init={ fmt.Sprintf("$watch('$store.params.params.pid', pid => updateActor('%s', pid))", props.ID.String()) }
			>
				<div class="flex flex-col w-64 h-full border-r border-neutral">
					<div class="flex items-center justify-center pt-2 font-bold">Actors</div>
					<div class="divider divider-neutral px-6 m-0"></div>
					<ul
						id="actors"
						class="menu menu-sm"
						sse-swap={ types.SseTypeNewActor }
						hx-swap="afterbegin"
					>
						for _, actorProps := range props.ActorProps {
							@ProjectActorListItem(actorProps, props.ID)
						}
					</ul>
				</div>
				<script>
					function updateActor(projectID, pid) {
						htmx.ajax("GET", "/project/" + projectID + "/actor?pid=" + pid, {target:'#actor-content', swap:'outerHTML'});
					}
				</script>
				if actorIndex >= 0 {
					@ActorContent(props.ID, props.ActorProps[actorIndex])
				} else {
					@ActorContent(props.ID, types.ProjectActorProps{})
				}
			</div>
		</div>
	}
}

script initStore(pid string, tab string) {
	document.addEventListener('alpine:init', () => {
        Alpine.store('params', {
            params: { 
				'pid': pid,
				'tab': tab,
			},

			init() {
				const url = new URL(window.location.href);
				history.replaceState({ "params": {...this.params} }, "", url);
			},
 
            set(key, val) {
				if (val === this.params[key]) {
					return;
				}
                this.params[key] = val;
				const url = new URL(window.location.href);
				url.searchParams.set(key, val);
				history.pushState({ "params": {...this.params} }, "", url);
            },

			get(key) {
				return this.params[key];
			},

			setAll(params) {
				this.params = params
			},
        });

		Alpine.store('params').init();
    });

	window.addEventListener("popstate", (e) => {
    	if(e.state && e.state.params){
			Alpine.store('params').setAll(e.state.params)
    	}
	});
}

const (
	tabLabelEvents = "Events"
	tabLabelTest   = "Test"
)

templ ActorContent(projectID uuid.UUID, props types.ProjectActorProps) {
	<div
		id="actor-content"
		class="flex flex-col grow max-h-full min-h-full min-w-0"
	>
		<div class="p-2 font-bold">{ props.PID }</div>
		<div
			role="tablist"
			class="tabs tabs-bordered"
		>
			@actorTab(tabLabelEvents)
			@actorTab(tabLabelTest)
		</div>
		@actorTabContent(tabLabelEvents) {
			@ProjectActorEventsContainer(projectID, props)
		}
	</div>
}

templ actorTab(label string) {
	<a
		role="tab"
		@click={ fmt.Sprintf("$store.params.set('tab', '%s')", label) }
		:class={ fmt.Sprintf("$store.params.get('tab') === '%s' ? 'tab tab-active' : 'tab'", label) }
	>{ label }</a>
}

templ actorTabContent(label string) {
	<div
		class="grow min-h-0"
		x-show={ fmt.Sprintf("$store.params.get('tab') === '%s'", label) }
	>
		{ children... }
	</div>
}

templ ProjectActorListItem(props types.ProjectActorProps, projectID uuid.UUID) {
	<li
		class="max-w-full"
		sse-swap={ types.SseTypeDeleteActor + props.PID }
		hx-swap="outerHTML"
		@click={ fmt.Sprintf("$store.params.set('pid', '%s')", props.PID) }
	>
		<a
			class="flex flex-row items-center justify-between w-full"
			:class={ fmt.Sprintf("$store.params.get('pid') === '%s' ? 'active' : ''", props.PID) }
		>
			<div class="grow min-w-0 mr-2 truncate">{ props.PID }</div>
			@ProjectActorBadge(props.PID, props.NumEvents, props.Alive)
		</a>
	</li>
}

templ ProjectActorBadge(pid string, numEvents int32, alive bool) {
	<div
		class={ "badge",  templ.KV("badge-success", alive), templ.KV("badge-error", !alive) }
		sse-swap={ types.SseTypeUpdateActorNumEvents + pid }
		hx-swap="outerHTML"
	>
		if numEvents > 999 {
			{ "999+" }
		} else {
			{ fmt.Sprintf("%d", numEvents) }
		}
	</div>
}

templ ProjectActorEventsContainer(projectID uuid.UUID, props types.ProjectActorProps) {
	<div
		id="events-container"
		class="overflow-x-auto max-h-full h-full"
		x-data="{ scrollTop: 0 }"
		@scroll={ fmt.Sprintf("$data.scrollTop = handleScroll('%s', $data)", formatActorPID(props.PID)) }
	>
		<script>
			function handleScroll(pid, { scrollTop }) {
				const container = document.getElementById("events-container");
				if (container.scrollTop < scrollTop) {
					if (loadNext(container)) {
						htmx.trigger('#events-top-data-loader-' + pid , 'load-next', {})
					}
				} else if (container.scrollTop > scrollTop) {
					if (loadPrev(container)) {
						htmx.trigger('#events-bottom-data-loader-' + pid, 'load-prev', {})
					}
				}
				return container.scrollTop;
			}

			function loadNext(container) {
				return container.scrollTop <= container.scrollHeight * 0.1;
			}

			function loadPrev(container) {
				return container.scrollTop + container.offsetHeight >= container.scrollHeight * 0.9;
			}
		</script>
		<table id="events-table" class="table table-pin-rows">
			<thead>
				<tr>
					<th>Timestamp</th>
					<th>PID</th>
					<th>Type</th>
					<th>Sender</th>
					<th>Level</th>
					<th>Message</th>
				</tr>
			</thead>
			<tbody
				id="events-container"
			>
				@eventsTopDataLoader(projectID, props.PID, props.NumEvents, props.NumEvents, false, false)
				@eventsBottomDataLoader(projectID, props.PID, props.NumEvents, props.NumEvents, false)
			</tbody>
		</table>
	</div>
}

templ eventsTopDataLoader(projectID uuid.UUID, actorPID string, startIdx int32, endIdx int32, oob bool, moreEvents bool) {
	<tr
		id={ "events-top-data-loader-" + formatActorPID(actorPID) }
		hx-get={ fmt.Sprintf("/project/%s/events?pid=%s&start=%d&end=%d&n=%d", projectID.String(), actorPID, startIdx, endIdx, 10) }
		if moreEvents {
			hx-trigger="load-next once, intersect once"
		} else {
			hx-trigger="every 1s [load()]"
		}
		hx-swap="outerHTML"
		if oob {
			hx-swap-oob="true"
		}
	>
		<script>
			function load() {
				const container = document.getElementById("events-container");
				return loadNext(container);
			}
		</script>
	</tr>
}

templ eventsBottomDataLoader(projectID uuid.UUID, actorPID string, startIdx int32, endIdx int32, oob bool) {
	if startIdx > 0 {
		<tr
			id={ "events-bottom-data-loader-" + formatActorPID(actorPID) }
			hx-get={ fmt.Sprintf("/project/%s/events?pid=%s&start=%d&end=%d&n=%d", projectID.String(), actorPID, startIdx, endIdx, -10) }
			hx-trigger="load-prev once, intersect once"
			hx-swap="outerHTML"
			if oob {
				hx-swap-oob="true"
			}
		></tr>
	} else {
		<tr id={ "events-bottom-data-loader-" + formatActorPID(actorPID) }></tr>
	}
}

func formatActorPID(pid string) string {
	return strings.ReplaceAll(pid, "/", "-")
}

templ ProjectActorEvents(projectID uuid.UUID, actorPID string, events types.EventList, delete []int32, startIdx int32, endIdx int32, appendEnd bool, moreEvents bool) {
	@eventsTopDataLoader(projectID, actorPID, startIdx, endIdx, !appendEnd, moreEvents)
	for i := len(events)-1; i >= 0; i-- {
		@projectActorEvent(events[i])
	}
	for _, i := range delete {
		@projectActorEventDelete(i)
	}
	@eventsBottomDataLoader(projectID, actorPID, startIdx, endIdx, appendEnd)
}

templ projectActorEvent(event types.Event) {
	<tr id={ fmt.Sprintf("event-%d", event.Index) }>
		<td>
			{ event.Timestamp.String() }
		</td>
		<td>
			{ event.Event.PID }
		</td>
		<td>
			{ event.MsgType }
		</td>
		<td>
			{ event.Event.Sender }
		</td>
		<td>
			{ event.Level.String() }
		</td>
		<td>
			{ event.Msg }
		</td>
	</tr>
}

templ projectActorEventDelete(index int32) {
	<tr id={ fmt.Sprintf("event-%d", index) } hx-swap-oob="delete"></tr>
}
