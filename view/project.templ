package view

import (
	"context"
	"fmt"
	gong_common "gong/common"
	"gong/view/common"
	"gong/view/overview"
)

templ Project(props gong_common.ProjectProps) {
	@common.Index() {
		<div id="includes" hx-include={ common.Includes }></div>
		<script>
			const next = htmx.createEventSource;
			htmx.createEventSource = function(url) {
				const elem = htmx.find("#includes");
				const params = new URLSearchParams(htmx.values(elem).entries());
				url = url + "?" + params.toString();
				return next(url);
			}
		</script>
		<div
			class="flex flex-col h-screen w-screen max-h-screen max-w-screen"
			hx-ext="sse"
			sse-connect={ "/project/" + props.ID.String() + "/sse/project" }
			x-data
		>
			<div class="grid grid-cols-6 border-b border-color py-2 px-4 w-full items-center z-50 bg-base-100">
				<div class="flex flex-row justify-begin">
					@common.LogoIcon("w-8 h-8 max-w-8 max-h-8")
				</div>
				<div class="flex flex-row col-span-4 justify-center">
					<div class="flex text-md font-bold items-center justify-center cursor-default">
						Project
					</div>
					<div class="dropdown ml-2">
						<div tabindex="0" role="button" class="btn btn-ghost btn-sm no-animation">{ props.ID.String() }</div>
						<ul tabindex="0" class="dropdown-content z-50 menu p-1 shadow bg-base-100 rounded-box w-full">
							<li><a>Item 1</a></li>
							<li><a>Item 2</a></li>
						</ul>
					</div>
				</div>
				<div></div>
			</div>
			<div class="flex flex-row grow min-w-full min-h-0">
				@ProjectActorList(props)
				if pid, ok := ctx.Value(gong_common.CtxPID).(string); ok {
					@ActorContent(props.Actors[pid])
				} else {
					@ActorContent(gong_common.Actor{})
				}
			</div>
		</div>
	}
}

templ ProjectActorList(props gong_common.ProjectProps) {
	<div class="flex flex-col w-64 min-w-64 h-full border-r border-color">
		<div class="flex items-center justify-center pt-2 font-bold cursor-default">Actors</div>
		<div class="border border-color mx-6 mt-2"></div>
		<ul
			id="actor-list"
			class="menu menu-sm"
			sse-swap={ gong_common.SseTypeNewActor }
			hx-swap="afterbegin"
			x-data="{ active: ''}"
		>
			for _, actor := range props.Actors {
				@ProjectActorListItem(actor, false)
			}
		</ul>
	</div>
}

func isCurrentPID(ctx context.Context, actorPID string) bool {
	if pid, ok := ctx.Value(gong_common.CtxPID).(string); ok {
		return pid == actorPID
	}
	return false
}

script resetActiveListItem(id string) {
	console.log("reset", id)
	const activeElems = document.getElementById('actor-list').querySelectorAll('.active');
	for (const elem of activeElems) {
		if (elem.parentNode.id !== id) {
			elem.classList.remove('active');
			const scripts = elem.querySelectorAll('script');
			for (const script of scripts) {
				htmx.remove(script);
			}
		}
	}
}

templ ProjectActorListItem(actor gong_common.Actor, oob bool) {
	<li
		id={ "actor-list-item-" + formatActorPID(actor.PID) }
		class="max-w-full"
		hx-get={ common.FormatProjectUrl(ctx) }
		hx-headers={ fmt.Sprintf(`{"View": "%s"}`, gong_common.ProjectViewActor) }
		hx-vals={ fmt.Sprintf(`{"pid": "%s"}`, actor.PID) }
		hx-include={ common.Includes }
		hx-trigger="click"
		hx-push-url="true"
		if oob {
			hx-swap-oob="true"
		}
	>
		<a
			class={ "flex flex-row items-center justify-between w-full cursor-pointer", templ.KV("active", isCurrentPID(ctx, actor.PID)) }
		>
			<div class="grow min-w-0 mr-2 truncate">{ actor.PID }</div>
			@ProjectActorBadge(actor)
			if isCurrentPID(ctx, actor.PID) {
				@resetActiveListItem("actor-list-item-" + formatActorPID(actor.PID))
			}
		</a>
	</li>
}

templ ProjectActorBadge(actor gong_common.Actor) {
	<div
		class={ "badge",  templ.KV("badge-success", actor.Alive), templ.KV("badge-error", !actor.Alive) }
		sse-swap={ gong_common.SseTypeUpdateActorNumEvents + actor.PID }
		hx-target="this"
		hx-swap="outerHTML"
	>
		if actor.NumEvents > 999 {
			{ "999+" }
		} else {
			{ fmt.Sprintf("%d", actor.NumEvents) }
		}
	</div>
}

const (
	tabLabelOverview = "Overview"
	tabLabelEvents   = "Events"
	tabLabelFlow     = "Flow"
)

templ ProjectActor(actor gong_common.Actor) {
	@ActorContent(actor)
	@ProjectActorListItem(actor, true)
}

templ ActorContent(actor gong_common.Actor) {
	<div
		id="actor-content"
		class="flex flex-col grow max-h-full min-h-full min-w-0"
		hx-swap-oob="true"
	>
		<input id="actor-pid" type="hidden" name={ gong_common.ParamPID } value={ actor.PID }/>
		<input id="tab" type="hidden" name={ gong_common.ParamTab } value={ ctx.Value(gong_common.CtxTab).(string) }/>
		<div class="p-4 font-bold">{ actor.PID }</div>
		<div
			role="tablist"
			class="tabs tabs-bordered"
		>
			@tab(tabLabelOverview)
			@tab(tabLabelEvents)
			@tab(tabLabelFlow)
		</div>
		@tabContent(tabLabelOverview) {
			@overview.OverviewTabContent(actor)
		}
		@tabContent(tabLabelEvents) {
			@eventsTabContent(actor)
		}
		@tabContent(tabLabelFlow) {
			@overview.FlowChartWidget()
		}
	</div>
}

templ tab(label string) {
	if active, ok := ctx.Value(gong_common.CtxTab).(string); ok {
		<a
			role="tab"
			class={ "tab", templ.KV("tab-active", label == active) }
			if label != active {
				hx-get={ common.FormatProjectUrl(ctx) }
				hx-headers={ fmt.Sprintf(`{"View": "%s"}`, gong_common.ProjectViewActor) }
				hx-vals={ fmt.Sprintf(`{"tab": "%s"}`, label) }
				hx-include={ common.Includes }
				hx-push-url="true"
				hx-trigger="click"
				hx-swap="none"
			}
		>{ label }</a>
	}
}

templ tabContent(label string) {
	if activeTab, ok := ctx.Value(gong_common.CtxTab).(string); ok && label == activeTab {
		<div
			class="flex flex-col grow min-h-0"
		>
			{ children... }
		</div>
	}
}
