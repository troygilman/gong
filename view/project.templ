package view

import (
	"fmt"
	"github.com/google/uuid"
	"gong/types"
)

templ Project(props types.ProjectProps) {
	@Index() {
		@initProject()
		<div
 			class="flex flex-col h-screen w-screen max-h-screen max-w-screen"
 			hx-ext="sse"
 			sse-connect={ "/project/" + props.ID.String() + "/sse" }
 			x-data
		>
			<div class="flex flex-row border-b border-neutral py-2 px-4 w-full items-center justify-center drop-shadow z-50">
				<div class="flex text-md font-bold items-center justify-center">
					Project
				</div>
				<div class="dropdown ml-2">
					<div tabindex="0" role="button" class="btn btn-ghost btn-sm no-animation">{ props.ID.String() }</div>
					<ul tabindex="0" class="dropdown-content z-50 menu p-1 shadow bg-base-100 rounded-box w-full">
						<li><a>Item 1</a></li>
						<li><a>Item 2</a></li>
					</ul>
				</div>
			</div>
			<div class="flex flex-row grow min-w-full min-h-0">
				@ProjectActorList(props)
				if pid, ok := ctx.Value(types.CtxPID).(string); ok {
					@ActorContent(props.ID, props.ActorProps[pid])
				} else {
					@ActorContent(props.ID, types.ProjectActorProps{})
				}
			</div>
		</div>
	}
}

script initProject() {
	window.addEventListener("popstate", (e) => {
    	if(e.state && e.state.html){
     		console.log('popState', history.length);
     		document.body.innerHTML = e.state.html;
       		htmx.process(document.body);
    	}
	});
}

templ ProjectActorList(props types.ProjectProps) {
	<div class="flex flex-col w-64 h-full border-r border-neutral">
		<div class="flex items-center justify-center pt-2 font-bold">Actors</div>
		<div class="divider divider-neutral px-6 m-0"></div>
		<ul
 			id="actor-list"
 			class="menu menu-sm"
 			sse-swap={ types.SseTypeNewActor }
 			hx-swap="afterbegin"
 			x-data="{ active: ''}"
		>
			<script>
				function resetActive() {
					const activeElem = document.getElementById('actor-list').querySelector('.active');
					if (activeElem) {
						activeElem.classList.remove('active');
					}
				}
			</script>
			for _, actorProps := range props.ActorProps {
				@ProjectActorListItem(actorProps, props.ID)
			}
		</ul>
	</div>
}

func isCurrentPID(ctx context.Context, actorPID string) bool {
	if pid, ok := ctx.Value(types.CtxPID).(string); ok {
		return pid == actorPID
	}
	return false
}

templ ProjectActorListItem(props types.ProjectActorProps, projectID uuid.UUID) {
	<li
 		class="max-w-full"
 		hx-get={ formatProjectUrl(ctx, "/actor") }
 		hx-vals={ fmt.Sprintf(`{"pid": "%s"}`, props.PID) }
 		hx-include={ includes }
 		hx-swap="none"
 		sse-swap={ types.SseTypeDeleteActor + props.PID }
	>
		<a
 			class={ "flex flex-row items-center justify-between w-full", templ.KV("active", isCurrentPID(ctx, props.PID)) }
 			@click="resetActive(); $el.classList.add('active');"
		>
			<div class="grow min-w-0 mr-2 truncate">{ props.PID }</div>
			@ProjectActorBadge(props.PID, props.NumEvents, props.Alive)
		</a>
	</li>
}

templ ProjectActorBadge(pid string, numEvents int32, alive bool) {
	<div
 		class={ "badge",  templ.KV("badge-success", alive), templ.KV("badge-error", !alive) }
 		sse-swap={ types.SseTypeUpdateActorNumEvents + pid }
 		hx-swap="outerHTML"
	>
		if numEvents > 999 {
			{ "999+" }
		} else {
			{ fmt.Sprintf("%d", numEvents) }
		}
	</div>
}

const (
	tabLabelEvents = "Events"
	tabLabelTest   = "Test"
)

templ ActorContent(projectID uuid.UUID, props types.ProjectActorProps) {
	<div
 		id="actor-content"
 		class="flex flex-col grow max-h-full min-h-full min-w-0"
 		hx-swap-oob="true"
	>
		@onActorContentLoad(formatProjectUrlWithParams(ctx))
		<input id="actor-pid" type="hidden" name="pid" value={ props.PID }/>
		<input id="tab" type="hidden" name="tab" value={ ctx.Value(types.CtxTab).(string) }/>
		<div class="p-2 font-bold">{ props.PID }</div>
		<div
 			role="tablist"
 			class="tabs tabs-bordered"
		>
			@actorTab(projectID, props.PID, tabLabelEvents)
			@actorTab(projectID, props.PID, tabLabelTest)
		</div>
		@actorTabContent(tabLabelEvents) {
			@eventsTabContent(props)
		}
	</div>
}

script onActorContentLoad(url string) {
	console.log("pushState", url);
	history.pushState({html: document.body.innerHTML}, "", url);
}

templ actorTab(projectID uuid.UUID, actorPID string, label string) {
	<a
 		role="tab"
 		if activeTab, ok := ctx.Value(types.CtxTab).(string); ok && activeTab == label {
			class="tab tab-active"
		} else {
			class="tab"
		}
 		hx-get={ formatProjectUrl(ctx, "/actor") }
 		hx-vals={ fmt.Sprintf(`{"tab": "%s"}`, label) }
 		hx-include={ includes }
 		hx-trigger="click"
 		hx-swap="none"
	>{ label }</a>
}

templ actorTabContent(label string) {
	if activeTab, ok := ctx.Value(types.CtxTab).(string); ok && label == activeTab {
		<div
 			class="flex flex-col grow min-h-0"
		>
			{ children... }
		</div>
	}
}
