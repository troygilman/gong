package view

import (
	"fmt"
	"github.com/google/uuid"
	"gong/types"
)

templ Project(props types.ProjectProps, actorIndex int) {
	@Index() {
		@initStore("", tabLabelEvents)
		<div
			class="flex flex-col h-screen w-screen max-h-screen max-w-screen"
			hx-ext="sse"
			sse-connect={ "/project/" + props.ID.String() + "/sse" }
			x-data
		>
			<div class="flex flex-row border-b border-neutral py-2 px-4 w-full items-center justify-center drop-shadow z-50">
				<div class="flex text-md font-bold items-center justify-center">
					Project
				</div>
				<div class="dropdown ml-2">
					<div tabindex="0" role="button" class="btn btn-ghost btn-sm no-animation">{ props.ID.String() }</div>
					<ul tabindex="0" class="dropdown-content z-50 menu p-1 shadow bg-base-100 rounded-box w-full">
						<li><a>Item 1</a></li>
						<li><a>Item 2</a></li>
					</ul>
				</div>
			</div>
			<div
				class="flex flex-row grow min-w-full min-h-0"
				x-init={ fmt.Sprintf("$watch('$store.params.params.pid', pid => updateActor('%s', pid))", props.ID.String()) }
			>
				<div class="flex flex-col w-64 h-full border-r border-neutral">
					<div class="flex items-center justify-center pt-2 font-bold">Actors</div>
					<div class="divider divider-neutral px-6 m-0"></div>
					<ul
						id="actors"
						class="menu menu-sm"
						sse-swap={ types.SseTypeNewActor }
						hx-swap="afterbegin"
					>
						for _, actorProps := range props.ActorProps {
							@ProjectActorListItem(actorProps, props.ID)
						}
					</ul>
				</div>
				<script>
					function updateActor(projectID, pid) {
						htmx.ajax("GET", "/project/" + projectID + "/actor?pid=" + pid, {target:'#actor-content', swap:'outerHTML'});
					}
				</script>
				if actorIndex >= 0 {
					@ActorContent(props.ID, props.ActorProps[actorIndex])
				} else {
					@ActorContent(props.ID, types.ProjectActorProps{})
				}
			</div>
		</div>
	}
}

script initStore(pid string, tab string) {
	document.addEventListener('alpine:init', () => {
        Alpine.store('params', {
            params: { 
				'pid': pid,
				'tab': tab,
			},

			init() {
				const url = new URL(window.location.href);
				history.replaceState({ "params": {...this.params} }, "", url);
			},
 
            set(key, val) {
				if (val === this.params[key]) {
					return;
				}
                this.params[key] = val;
				const url = new URL(window.location.href);
				url.searchParams.set(key, val);
				history.pushState({ "params": {...this.params} }, "", url);
            },

			get(key) {
				return this.params[key];
			},

			setAll(params) {
				this.params = params
			},
        });

		Alpine.store('params').init();
    });

	window.addEventListener("popstate", (e) => {
    	if(e.state && e.state.params){
			Alpine.store('params').setAll(e.state.params)
    	}
	});
}

const (
	tabLabelEvents = "Events"
	tabLabelTest   = "Test"
)

templ ActorContent(projectID uuid.UUID, props types.ProjectActorProps) {
	<div
		id="actor-content"
		class="flex flex-col grow max-h-full min-h-full min-w-0"
	>
		<div class="p-2 font-bold">{ props.PID }</div>
		<div
			role="tablist"
			class="tabs tabs-bordered"
		>
			@actorTab(tabLabelEvents)
			@actorTab(tabLabelTest)
		</div>
		@actorTabContent(tabLabelEvents) {
			@ProjectActorEventsContainer(projectID, props.PID)
		}
	</div>
}

templ actorTab(label string) {
	<a
		role="tab"
		@click={ fmt.Sprintf("$store.params.set('tab', '%s')", label) }
		:class={ fmt.Sprintf("$store.params.get('tab') === '%s' ? 'tab tab-active' : 'tab'", label) }
	>{ label }</a>
}

templ actorTabContent(label string) {
	<div
		class="grow min-h-0"
		x-show={ fmt.Sprintf("$store.params.get('tab') === '%s'", label) }
	>
		{ children... }
	</div>
}

templ ProjectActorListItem(props types.ProjectActorProps, projectID uuid.UUID) {
	<li
		class="max-w-full"
		sse-swap={ types.SseTypeDeleteActor + props.PID }
		hx-swap="outerHTML"
		@click={ fmt.Sprintf("$store.params.set('pid', '%s')", props.PID) }
	>
		<a
			class="flex flex-row items-center justify-between w-full"
			:class={ fmt.Sprintf("$store.params.get('pid') === '%s' ? 'active' : ''", props.PID) }
		>
			<div class="grow min-w-0 mr-2 truncate">{ props.PID }</div>
			@ProjectActorBadge(props.PID, props.NumEvents, props.Alive)
		</a>
	</li>
}

templ ProjectActorBadge(pid string, numEvents int32, alive bool) {
	<div
		class={ "badge",  templ.KV("badge-success", alive), templ.KV("badge-error", !alive) }
		sse-swap={ types.SseTypeUpdateActorNumEvents + pid }
		hx-swap="outerHTML"
	>
		if numEvents > 999 {
			{ "999+" }
		} else {
			{ fmt.Sprintf("%d", numEvents) }
		}
	</div>
}

templ ProjectActorEventsContainer(projectID uuid.UUID, pid string) {
	<div class="overflow-x-auto max-h-full h-full">
		<script>
			function resizeContainer() {
				const container = document.getElementById("events-container")
				while (container.children.length > 100) {
					container.removeChild(container.lastChild);
				}
			}
			function handleTableUpdate(event) {
				const target = event.detail.target;
				if (target && (target.id == "events-container" || target.id == "events-container-data-loader")) {
					resizeContainer();
				}
			}
		</script>
		<table class="table table-pin-rows">
			<thead>
				<tr>
					<th>Timestamp</th>
					<th>PID</th>
					<th>Type</th>
					<th>Sender</th>
					<th>Level</th>
					<th>Message</th>
				</tr>
			</thead>
			<tbody
				id="events-container"
				hx-swap="afterbegin"
				sse-swap={ types.SseTypeNewEvents + pid }
				@htmx:after-settle="handleTableUpdate($event)"
			>
				<tr
					id="events-container-data-loader"
					hx-get={ fmt.Sprintf("/project/%s/events?pid=%s", projectID.String(), pid) }
					hx-trigger="load"
					hx-swap="outerHTML"
				></tr>
			</tbody>
		</table>
	</div>
}

templ ProjectActorEvents(events types.EventList) {
	for i := len(events)-1; i >= 0; i-- {
		@projectActorEvent(events[i])
	}
}

templ projectActorEvent(event types.Event) {
	<tr>
		<td>
			{ event.Timestamp.String() }
		</td>
		<td>
			{ event.Event.PID }
		</td>
		<td>
			{ event.MsgType }
		</td>
		<td>
			{ event.Event.Sender }
		</td>
		<td>
			{ event.Level.String() }
		</td>
		<td>
			{ event.Msg }
		</td>
	</tr>
}
