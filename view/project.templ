package view

import (
	"gong/sdk"
	"fmt"
	"gong/domain"
	"github.com/google/uuid"
)

templ Project(props domain.ProjectProps, actorIndex int) {
	@Index() {
		<div
			class="flex flex-col h-screen w-screen max-h-screen max-w-screen"
			hx-ext="sse,debug"
			sse-connect={ "/project/" + props.ID.String() + "/sse" }
		>
			<div class="border-b">
				Project { props.ID.String() }
			</div>
			<div class="flex flex-row grow min-w-full min-h-0">
				<div class="flex flex-col w-64 h-full border-r">
					<div class="border-b">
						Actors
					</div>
					<div
						id="actors"
						class="flex flex-col"
						sse-swap="sse-new"
						hx-swap="afterbegin"
					>
						for _, actorProps := range props.ActorProps {
							@ProjectActor(actorProps, props.ID)
						}
					</div>
				</div>
				<div class="flex flex-col grow min-h-full min-w-0">
					<div class="border-b">
						Events
					</div>
					if actorIndex >= 0 {
						@ProjectActorEventsContainer(props.ID, props.ActorProps[actorIndex].PID, []sdk.Event{}, true)
					} else {
						@ProjectActorEventsContainer(props.ID, "", []sdk.Event{}, false)
					}
				</div>
			</div>
		</div>
	}
}

func fmtProjectEventsEndpoint(projectID uuid.UUID, actorPID string) string {
	return fmt.Sprintf("/project/%s/events?actor=%s", projectID.String(), actorPID)
}

templ ProjectActor(props domain.ProjectActorProps, projectID uuid.UUID) {
	<div
		sse-swap={ "sse-delete-" + props.PID }
		hx-swap="outerHTML"
	>
		<div
			hx-get={ fmtProjectEventsEndpoint(projectID, props.PID) }
			hx-trigger="click"
			hx-swap="none"
		>
			<div class="flex flex-row">
				{ props.PID }
				{ fmt.Sprintf("%d", props.NumEvents) }
			</div>
		</div>
	</div>
}

templ ProjectActorEventsContainer(projectID uuid.UUID, pid string, events []sdk.Event, lazyLoad bool) {
	<div class="overflow-x-auto">
		<table class="table table-pin-rows">
			<thead>
				<tr>
					<th>Timestamp</th>
					<th>Type</th>
					<th>Level</th>
					<th>Message</th>
				</tr>
			</thead>
			<tbody
				id="events-container"
				sse-swap={ "sse-update-" + pid }
				hx-swap="afterbegin"
				hx-swap-oob="true"
				if lazyLoad {
					hx-get={ fmt.Sprintf("/project/%s/events?actor=%s", projectID.String(), pid) }
				}
			>
				@ProjectActorEvents(events)
			</tbody>
		</table>
	</div>
}

templ ProjectActorEvents(events []sdk.Event) {
	for i := len(events)-1; i >= 0; i-- {
		@projectActorEvent(events[i])
	}
}

templ projectActorEvent(event sdk.Event) {
	<tr>
		<td>
			{ event.Timestamp.String() }
		</td>
		<td>
			{ event.MsgType }
		</td>
		<td>
			{ event.Level.String() }
		</td>
		<td>
			{ event.Msg }
		</td>
	</tr>
}
