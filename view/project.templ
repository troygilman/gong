package view

import (
	"fmt"
	"gong/domain"
	"github.com/google/uuid"
	"gong/types"
)

templ Project(props domain.ProjectProps, actorIndex int) {
	@Index() {
		@initStore(props.ID.String(), "", tabLabelEvents)
		<div
			class="flex flex-col h-screen w-screen max-h-screen max-w-screen"
			hx-ext="sse"
			sse-connect={ "/project/" + props.ID.String() + "/sse" }
			x-data
		>
			<div class="border-b">
				Project { props.ID.String() }
			</div>
			<div class="flex flex-row grow min-w-full min-h-0">
				<div class="flex flex-col w-64 h-full border-r">
					<div class="border-b">
						Actors
					</div>
					<div
						id="actors"
						class="flex flex-col"
						sse-swap={ types.SseTypeNewActor }
						hx-swap="afterbegin"
					>
						for _, actorProps := range props.ActorProps {
							@ProjectActorListItem(actorProps, props.ID)
						}
					</div>
				</div>
				if actorIndex >= 0 {
					@actorContent(props.ID, props.ActorProps[actorIndex])
				} else {
					@actorContent(props.ID, domain.ProjectActorProps{})
				}
			</div>
		</div>
	}
}

script initStore(projectID string, actor string, tab string) {
	document.addEventListener('alpine:init', () => {
		Alpine.store('projectID', projectID);
        Alpine.store('params', {
            params: { 
				'actor': actor,
				'tab': tab,
			},
 
            set(key, val) {
                this.params[key] = val;

				const url = new URL(window.location.href);
				url.searchParams.set(key, val);
				history.pushState({ "params": {...this.params} }, "", url);
            },

			get(key) {
				return this.params[key];
			},

			setAll(params) {
				const props = {};
				for (var prop in this.params) {
					if (params[prop]) {
						this.params[prop] = params[prop];
						props[prop] = true;
					} else {
						delete this.params[prop];
					}
				}
				for (var prop in params) {
					if (!props[prop]) {
						this.params[prop] = params[prop];
					}
				}
			},
        });
    });

	window.addEventListener("popstate", (e) => {
    	if(e.state && e.state.params){
			Alpine.store('params').setAll(e.state.params)
    	}
	});
}

const (
	tabLabelEvents = "Events"
	tabLabelTest   = "Test"
)

templ actorContent(projectID uuid.UUID, props domain.ProjectActorProps) {
	<div
		id="actor-content"
		class="flex flex-col grow max-h-full min-h-full min-w-0"
	>
		<div
			role="tablist"
			class="tabs tabs-bordered"
		>
			@actorTab(tabLabelEvents)
			@actorTab(tabLabelTest)
		</div>
		@actorTabContent(tabLabelEvents) {
			@ProjectActorEventsContainer(projectID, props.PID, make(types.EventList, 0), true)
		}
	</div>
}

templ actorTab(label string) {
	<a
		role="tab"
		@click={ fmt.Sprintf("$store.params.set('tab', '%s')", label) }
		:class={ fmt.Sprintf("$store.params.get('tab') === '%s' ? 'tab tab-active' : 'tab'", label) }
	>{ label }</a>
}

templ actorTabContent(label string) {
	<div
		class="grow min-h-0"
		x-show={ fmt.Sprintf("$store.params.get('tab') === '%s'", label) }
	>
		{ children... }
	</div>
}

func fmtProjectEventsEndpoint(projectID uuid.UUID, actorPID string) string {
	return fmt.Sprintf("/project/%s/events?actor=%s", projectID.String(), actorPID)
}

templ ProjectActorListItem(props domain.ProjectActorProps, projectID uuid.UUID) {
	<div
		class="cursor-pointer"
		sse-swap={ types.SseTypeDeleteActor + props.PID }
		hx-swap="outerHTML"
	>
		<div
			@click={ fmt.Sprintf("$store.params.set('actor', '%s')", props.PID) }
		>
			<div class="flex flex-row items-center justify-between w-full">
				{ props.PID }
				<div
					class="badge badge-secondary"
					sse-swap={ types.SseTypeUpdateActorNumEvents + props.PID }
					hx-swap="innerHTML"
				>
					@ProjectActorNumEvents(props.NumEvents)
				</div>
			</div>
		</div>
	</div>
}

templ ProjectActorNumEvents(numEvents int32) {
	if numEvents > 999 {
		{ "999+" }
	} else {
		{ fmt.Sprintf("%d", numEvents) }
	}
}

templ ProjectActorEventsContainer(projectID uuid.UUID, pid string, events types.EventList, lazyLoad bool) {
	<div class="overflow-x-auto max-h-full">
		<script>
			function updateActor(projectID, pid) {
				htmx.ajax("GET", "/project/" + projectID + "/events?actor=" + pid, "#events-container")
			}
		</script>
		<table class="table table-pin-rows">
			<thead>
				<tr>
					<th>Timestamp</th>
					<th>Type</th>
					<th>Level</th>
					<th>Message</th>
				</tr>
			</thead>
			<tbody
				id="events-container"
				sse-swap={ types.SseTypeNewEvents + pid }
				hx-swap="afterbegin"
				hx-swap-oob="true"
				if lazyLoad {
					hx-get={ fmtProjectEventsEndpoint(projectID, pid) }
				}
				x-init="$watch('$store.params.params.actor', a => updateActor($store.projectID, a))"
			>
				@ProjectActorEvents(events)
			</tbody>
		</table>
	</div>
}

templ ProjectActorEvents(events types.EventList) {
	for i := len(events)-1; i >= 0; i-- {
		@projectActorEvent(events[i])
	}
}

templ projectActorEvent(event types.Event) {
	<tr>
		<td>
			{ event.Timestamp.String() }
		</td>
		<td>
			{ event.MsgType }
		</td>
		<td>
			{ event.Level.String() }
		</td>
		<td>
			{ event.Msg }
		</td>
	</tr>
}
